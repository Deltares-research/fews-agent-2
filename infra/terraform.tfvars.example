# terraform.tfvars.example — Template for Terraform variables
#
# Copy to terraform.tfvars (gitignored) and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars

# Resource group name (must already exist in Azure)
resource_group_name = "FEWS_LLM"

# Azure AI endpoint URL (from Azure portal)
azure_ai_api_base = "https://your-resource.services.ai.azure.com/models"

# Azure AI API key (from Azure portal - keep secret!)
azure_ai_api_key = "your-api-key-here"

# LLM model identifier
fews_agent_model = "azure_ai/Llama-3.3-70B-Instruct"

# --- Session store (PHASE=prod mirrors project sessions to Azure Blob) ---

# dev = local disk only; prod = blob-backed (survives container restarts)
phase = "prod"

# Storage account -> Access keys -> key1 -> Connection string (keep secret!)
azure_storage_connection_string = "DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"

# Blob container for sessions (auto-created on first use)
azure_storage_container = "fews-projects"

# Optional subpath inside the container. PERMANENT once chosen - changing it
# later hides every session stored under the old prefix.
azure_storage_prefix = "projects"
