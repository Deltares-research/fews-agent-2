{# Helper: emit a list of dict-bodied children under one tag name, in
   order. Each list item becomes one <tag>...</tag> with its dict
   contents rendered via dict_to_xml (handles @attr and child elems). #}
{%- macro emit_list(tag, items) -%}
{%- for it in items -%}
<{{ tag }}{% for k, v in it.items() if k.startswith('@') %} {{ k[1:] }}="{{ v }}"{% endfor %}>{{ it | dict_to_xml | safe }}</{{ tag }}>
{% endfor %}
{%- endmacro -%}
{%- macro emit_one(tag, item) -%}
{%- if item is not none -%}
<{{ tag }}{% for k, v in item.items() if k.startswith('@') %} {{ k[1:] }}="{{ v }}"{% endfor %}>{{ item | dict_to_xml | safe }}</{{ tag }}>
{%- endif -%}
{%- endmacro -%}
