{%- import "_partials/timeseries_set.xml.j2" as tss -%}
{%- macro col(c, tag) -%}
<{{ tag }}{% if c.name is not none %} name="{{ c.name }}"{% endif %}
{%- if c.pattern is defined and c.pattern is not none %} pattern="{{ c.pattern }}"{% endif %}
{%- if c.unit is defined and c.unit is not none %} unit="{{ c.unit }}"{% endif %}
{%- if c.parameterId is defined and c.parameterId is not none %} parameterId="{{ c.parameterId }}"{% endif %}
{%- if c.locationId is defined and c.locationId is not none %} locationId="{{ c.locationId }}"{% endif %}
{%- if c.parser is defined and c.parser is not none %} parser="{{ c.parser }}"{% endif %}
{%- if c.ensembleMemberIndex is defined and c.ensembleMemberIndex is not none %} ensembleMemberIndex="{{ c.ensembleMemberIndex }}"{% endif %}
{%- if c.time is defined and c.time is not none %} time="{{ c.time }}"{% endif %}
{%- if c.dayOfMonth is defined and c.dayOfMonth is not none %} dayOfMonth="{{ c.dayOfMonth }}"{% endif %}
{%- if c.prefix is defined and c.prefix is not none %} prefix="{{ c.prefix }}"{% endif %}
{%- if c.defaultValue is defined and c.defaultValue is not none %} defaultValue="{{ c.defaultValue }}"{% endif %}
{%- if c.id is defined and c.id is not none %} id="{{ c.id }}"{% endif %}
{%- if c.key is defined and c.key is not none %} key="{{ c.key }}"{% endif %}
{%- if c.ignoreForEnumerationParameters is defined and c.ignoreForEnumerationParameters is not none %} ignoreForEnumerationParameters="{{ 'true' if c.ignoreForEnumerationParameters else 'false' }}"{% endif %}
{%- if c.requireEnumerationParameters is defined and c.requireEnumerationParameters is not none %} requireEnumerationParameters="{{ 'true' if c.requireEnumerationParameters else 'false' }}"{% endif %}
{%- if c.ignoreForNumericalParameters is defined and c.ignoreForNumericalParameters is not none %} ignoreForNumericalParameters="{{ 'true' if c.ignoreForNumericalParameters else 'false' }}"{% endif %}
{%- if c.requireNumericalParameters is defined and c.requireNumericalParameters is not none %} requireNumericalParameters="{{ 'true' if c.requireNumericalParameters else 'false' }}"{% endif %}/>
{%- endmacro -%}
{%- macro tzone(tz) -%}
{%- if tz.timeZoneName is not none %}<timeZoneName>{{ tz.timeZoneName }}</timeZoneName>{% endif %}
{%- if tz.timeZoneOffset is not none %}<timeZoneOffset>{{ tz.timeZoneOffset }}</timeZoneOffset>{% endif %}
{%- endmacro -%}
{%- macro tstep(t, tag) -%}
{%- if t.id is not none %}<{{ tag }} id="{{ t.id }}"/>{% else %}<{{ tag }} unit="{{ t.unit }}"{% if t.multiplier is not none %} multiplier="{{ t.multiplier }}"{% endif %}/>{% endif %}
{%- endmacro -%}
{%- macro relp(p, tag) -%}
<{{ tag }} unit="{{ p.unit }}"{% if p.start is not none %} start="{{ p.start }}"{% endif %}{% if p.end is not none %} end="{{ p.end }}"{% endif %}{% if p.startOverrulable is not none %} startOverrulable="{{ 'true' if p.startOverrulable else 'false' }}"{% endif %}{% if p.endOverrulable is not none %} endOverrulable="{{ 'true' if p.endOverrulable else 'false' }}"{% endif %}/>
{%- endmacro -%}
{%- macro emit_table(tb) -%}
<table{% if tb.name is not none %} name="{{ tb.name }}"{% endif %}>
      {%- if tb.locationColumn is not none %}{{ col(tb.locationColumn, "locationColumn") }}{% endif %}
      {%- if tb.dateTimeColumn is not none %}{{ col(tb.dateTimeColumn, "dateTimeColumn") }}{% endif %}
      {%- for c in tb.dateColumn %}{{ col(c, "dateColumn") }}{% endfor %}
      {%- for c in tb.yearColumn %}{{ col(c, "yearColumn") }}{% endfor %}
      {%- for c in tb.monthColumn %}{{ col(c, "monthColumn") }}{% endfor %}
      {%- for c in tb.dayColumn %}{{ col(c, "dayColumn") }}{% endfor %}
      {%- for c in tb.timeColumn %}{{ col(c, "timeColumn") }}{% endfor %}
      {%- for c in tb.hourColumn %}{{ col(c, "hourColumn") }}{% endfor %}
      {%- for c in tb.minuteColumn %}{{ col(c, "minuteColumn") }}{% endfor %}
      {%- for c in tb.secondColumn %}{{ col(c, "secondColumn") }}{% endfor %}
      {%- for c in tb.forecastDateTimeColumn %}{{ col(c, "forecastDateTimeColumn") }}{% endfor %}
      {%- for c in tb.forecastDateColumn %}{{ col(c, "forecastDateColumn") }}{% endfor %}
      {%- for c in tb.forecastTimeColumn %}{{ col(c, "forecastTimeColumn") }}{% endfor %}
      {%- for c in tb.startDateTimeColumn %}{{ col(c, "startDateTimeColumn") }}{% endfor %}
      {%- for c in tb.endDateTimeColumn %}{{ col(c, "endDateTimeColumn") }}{% endfor %}
      {%- for c in tb.parameterColumn %}{{ col(c, "parameterColumn") }}{% endfor %}
      {%- for c in tb.qualifierColumn %}{{ col(c, "qualifierColumn") }}{% endfor %}
      {%- for c in tb.ensembleColumn %}{{ col(c, "ensembleColumn") }}{% endfor %}
      {%- for c in tb.ensembleMemberColumn %}{{ col(c, "ensembleMemberColumn") }}{% endfor %}
      {%- for c in tb.commentColumn %}{{ col(c, "commentColumn") }}{% endfor %}
      {%- for c in tb.userColumn %}{{ col(c, "userColumn") }}{% endfor %}
      {%- for c in tb.flagColumn %}{{ col(c, "flagColumn") }}{% endfor %}
      {%- for c in tb.flagSourceColumn %}{{ col(c, "flagSourceColumn") }}{% endfor %}
      {%- for c in tb.valueColumn %}{{ col(c, "valueColumn") }}{% endfor %}
      {%- for c in tb.unitColumn %}{{ col(c, "unitColumn") }}{% endfor %}
      {%- for c in tb.skippedColumn %}{{ col(c, "skippedColumn") }}{% endfor %}
      {%- for c in tb.sampleIdColumn %}{{ col(c, "sampleIdColumn") }}{% endfor %}
      {%- for c in tb.propertyColumn %}{{ col(c, "propertyColumn") }}{% endfor %}
      {%- for c in tb.attributeColumn %}{{ col(c, "attributeColumn") }}{% endfor %}
      {%- for c in tb.limitSymbolColumn %}{{ col(c, "limitSymbolColumn") }}{% endfor %}
      {%- for c in tb.lineNumberColumn %}{{ col(c, "lineNumberColumn") }}{% endfor %}
      </table>
{%- endmacro -%}
{%- macro emit_general(g) -%}
{%- set fnf = g.fileNameForecastCreationDateTimePattern %}
<general>
      {%- if g.description is not none %}<description>{{ g.description }}</description>{% endif %}
      {%- if g.importTypeStandard is not none %}<importTypeStandard>{{ g.importTypeStandard }}</importTypeStandard>
      {%- elif g.importType is not none %}<importType>{{ g.importType }}</importType>
      {%- elif g.parserClassName is not none %}<parserClassName>{{ g.parserClassName }}</parserClassName>{% if g.binDir is not none %}<binDir>{{ g.binDir }}</binDir>{% endif %}{% if g.moduleDataSetName is not none %}<moduleDataSetName>{{ g.moduleDataSetName }}</moduleDataSetName>{% endif %}{% endif %}
      {%- if g.folder is not none %}
      <folder>{{ g.folder }}</folder>
      {%- for fdf in g.fileNameDateTimeFilter %}
      <fileNameDateTimeFilter subFolderLevel="{{ fdf.subFolderLevel }}">{{ tstep(fdf.timeStep, "timeStep") }}<dateTimePattern>{{ fdf.dateTimePattern }}</dateTimePattern><preFixLength>{{ fdf.preFixLength }}</preFixLength><postFixLength>{{ fdf.postFixLength }}</postFixLength></fileNameDateTimeFilter>
      {%- endfor %}
      {%- if g.fileNamePatternFilter is not none %}<fileNamePatternFilter>{{ g.fileNamePatternFilter }}</fileNamePatternFilter>{% endif %}
      {%- if g.fileNameEnsembleMemberIndexPattern is not none %}<fileNameEnsembleMemberIndexPattern>{{ g.fileNameEnsembleMemberIndexPattern }}</fileNameEnsembleMemberIndexPattern>{% endif %}
      {%- if g.fileNameObservationDateTimePattern is not none %}<fileNameObservationDateTimePattern>{{ g.fileNameObservationDateTimePattern }}</fileNameObservationDateTimePattern>{% endif %}
      {%- if fnf is not none %}<fileNameForecastCreationDateTimePattern>{{ fnf }}</fileNameForecastCreationDateTimePattern>{% elif g.fileNamePrefixForecastCreationDateTimePattern is not none %}<fileNamePrefixForecastCreationDateTimePattern>{{ g.fileNamePrefixForecastCreationDateTimePattern }}</fileNamePrefixForecastCreationDateTimePattern>{% elif g.fileNamePostfixForecastCreationDateTimePattern is not none %}<fileNamePostfixForecastCreationDateTimePattern>{{ g.fileNamePostfixForecastCreationDateTimePattern }}</fileNamePostfixForecastCreationDateTimePattern>{% elif g.fileNameForecastCreationDateTimePatternFromZip is not none %}<fileNameForecastCreationDateTimePatternFromZip>{{ g.fileNameForecastCreationDateTimePatternFromZip }}</fileNameForecastCreationDateTimePatternFromZip>{% endif %}
      {%- if g.fileNameLocationIdPattern is not none %}<fileNameLocationIdPattern>{{ g.fileNameLocationIdPattern }}</fileNameLocationIdPattern>{% endif %}
      {%- if g.fileNameParameterIdPattern is not none %}<fileNameParameterIdPattern>{{ g.fileNameParameterIdPattern }}</fileNameParameterIdPattern>{% endif %}
      {%- if g.maxAllowedFolderSizeMB is not none %}<maxAllowedFolderSizeMB>{{ g.maxAllowedFolderSizeMB }}</maxAllowedFolderSizeMB>{% endif %}
      {%- if g.failedFolder is not none %}<failedFolder>{{ g.failedFolder }}</failedFolder>{% endif %}
      {%- if g.backupFolder is not none %}<backupFolder>{{ g.backupFolder }}</backupFolder>{% endif %}
      {%- if g.suspendedFolder is not none %}<suspendedFolder>{{ g.suspendedFolder }}</suspendedFolder>{% endif %}
      {%- for f in g.importTriggeringFile %}<importTriggeringFile>{{ f }}</importTriggeringFile>{% endfor %}
      {%- if g.groupImportPattern is not none %}<groupImportPattern><numberOfFiles>{{ g.groupImportPattern.numberOfFiles }}</numberOfFiles><fileNameDateTimePattern>{{ g.groupImportPattern.fileNameDateTimePattern }}</fileNameDateTimePattern><waitingTime unit="{{ g.groupImportPattern.waitingTime.unit }}" multiplier="{{ g.groupImportPattern.waitingTime.multiplier }}"/></groupImportPattern>{% endif %}
      {%- if g.deleteImportedFiles is not none %}<deleteImportedFiles>{{ 'true' if g.deleteImportedFiles else 'false' }}</deleteImportedFiles>{% endif %}
      {%- if g.ftpPassiveMode is not none %}<ftpPassiveMode>{{ 'true' if g.ftpPassiveMode else 'false' }}</ftpPassiveMode>{% endif %}
      {%- if g.sftpPrivateKeyFile is not none %}<sftpPrivateKeyFile>{{ g.sftpPrivateKeyFile }}</sftpPrivateKeyFile>{% elif g.sftpPrivateKey is not none %}<sftpPrivateKey>{{ g.sftpPrivateKey }}</sftpPrivateKey>{% endif %}
      {%- if g.sftpHostKeyFile is not none %}<sftpHostKeyFile>{{ g.sftpHostKeyFile }}</sftpHostKeyFile>{% endif %}
      {%- if g.sftpPassPhraseFile is not none %}<sftpPassPhraseFile>{{ g.sftpPassPhraseFile }}</sftpPassPhraseFile>{% elif g.sftpPassPhrase is not none %}<sftpPassPhrase>{{ g.sftpPassPhrase }}</sftpPassPhrase>{% endif %}
      {%- elif g.jdbcConnectionString is not none %}
      <jdbcDriverClass>{{ g.jdbcDriverClass }}</jdbcDriverClass>
      {%- if g.jdbcBinDir is not none %}<jdbcBinDir>{{ g.jdbcBinDir }}</jdbcBinDir>{% endif %}
      <jdbcConnectionString>{{ g.jdbcConnectionString }}</jdbcConnectionString>
      {%- if g.jdbcConnectionTimeOutMillis is not none %}<jdbcConnectionTimeOutMillis>{{ g.jdbcConnectionTimeOutMillis }}</jdbcConnectionTimeOutMillis>{% endif %}
      {%- elif g.serverUrl is not none %}
      <serverUrl>{{ g.serverUrl }}</serverUrl>
      {%- for u in g.backupServerUrl %}<backupServerUrl>{{ u }}</backupServerUrl>{% endfor %}
      {%- if g.downLoadFolder is not none %}<downLoadFolder>{{ g.downLoadFolder }}</downLoadFolder>{% endif %}
      {%- if g.fileNamePatternFilter is not none %}<fileNamePatternFilter>{{ g.fileNamePatternFilter }}</fileNamePatternFilter>{% endif %}
      {%- if g.fileNameObservationDateTimePattern is not none %}<fileNameObservationDateTimePattern>{{ g.fileNameObservationDateTimePattern }}</fileNameObservationDateTimePattern>{% endif %}
      {%- if g.connectionTimeOutMillis is not none %}<connectionTimeOutMillis>{{ g.connectionTimeOutMillis }}</connectionTimeOutMillis>{% endif %}
      {%- endif %}
      {%- if g.user is not none %}<user>{{ g.user }}</user>{% endif %}
      {%- if g.encryptedPassword is not none %}<encryptedPassword>{{ g.encryptedPassword }}</encryptedPassword>{% elif g.password is not none %}<password>{{ g.password }}</password>{% endif %}
      {%- if g.oauth2Config is not none %}{%- set o = g.oauth2Config %}<oauth2Config><authUrl>{{ o.authUrl }}</authUrl>{% if o.clientId is not none %}<clientId>{{ o.clientId }}</clientId>{% endif %}{% if o.clientSecret is not none %}<clientSecret>{{ o.clientSecret }}</clientSecret>{% endif %}{% for s in o.scope %}<scope>{{ s }}</scope>{% endfor %}{% for a in o.audience %}<audience>{{ a }}</audience>{% endfor %}{% if o.issuer is not none %}<issuer>{{ o.issuer }}</issuer>{% endif %}{% if o.refreshToken is not none %}<refreshToken>{{ o.refreshToken }}</refreshToken>{% endif %}</oauth2Config>{% endif %}
      {%- if g.forecastSearchPeriod is not none %}{{ relp(g.forecastSearchPeriod, "forecastSearchPeriod") }}
      {%- elif g.externalForecastTimesSearchRelativePeriod is not none %}{{ relp(g.externalForecastTimesSearchRelativePeriod, "externalForecastTimesSearchRelativePeriod") }}{{ tstep(g.externalForecastTimesCardinalTimeStep, "externalForecastTimesCardinalTimeStep") }}
      {%- else %}
      {%- if g.relativeViewPeriod is not none %}{{ relp(g.relativeViewPeriod, "relativeViewPeriod") }}{% elif g.startDateTime is not none %}<startDateTime>{{ g.startDateTime }}</startDateTime><endDateTime>{{ g.endDateTime }}</endDateTime>{% endif %}
      {%- if g.onlyGaps is not none %}<onlyGaps>{{ 'true' if g.onlyGaps else 'false' }}</onlyGaps>{% endif %}
      {%- endif %}
      {%- if g.forecastMaxAge is not none %}<forecastMaxAge unit="{{ g.forecastMaxAge.unit }}" multiplier="{{ g.forecastMaxAge.multiplier }}"/>{% endif %}
      {%- for tb in g.table %}{{ emit_table(tb) }}{% endfor %}
      {%- if g.validate_ is not none %}<validate>{{ 'true' if g.validate_ else 'false' }}</validate>{% endif %}
      {%- if g.logErrorsAsWarnings is not none %}<logErrorsAsWarnings>{{ 'true' if g.logErrorsAsWarnings else 'false' }}</logErrorsAsWarnings>{% elif g.logErrorsAsWarningsToFileOnly is not none %}<logErrorsAsWarningsToFileOnly>{{ 'true' if g.logErrorsAsWarningsToFileOnly else 'false' }}</logErrorsAsWarningsToFileOnly>{% endif %}
      {%- if g.logWarningsForUnmappableTimeSeries is not none %}<logWarningsForUnmappableTimeSeries>{{ 'true' if g.logWarningsForUnmappableTimeSeries else 'false' }}</logWarningsForUnmappableTimeSeries>{% endif %}
      {%- if g.failOnUnmappableTimeSeries is not none %}<failOnUnmappableTimeSeries>{{ 'true' if g.failOnUnmappableTimeSeries else 'false' }}</failOnUnmappableTimeSeries>{% endif %}
      {%- if g.logWarningsForUnmappableLocations is not none %}<logWarningsForUnmappableLocations>{{ 'true' if g.logWarningsForUnmappableLocations else 'false' }}</logWarningsForUnmappableLocations>{% endif %}
      {%- if g.logWarningsForUnmappableParameters is not none %}<logWarningsForUnmappableParameters>{{ 'true' if g.logWarningsForUnmappableParameters else 'false' }}</logWarningsForUnmappableParameters>{% endif %}
      {%- if g.logWarningsForUnmappableQualifiers is not none %}<logWarningsForUnmappableQualifiers>{{ 'true' if g.logWarningsForUnmappableQualifiers else 'false' }}</logWarningsForUnmappableQualifiers>{% endif %}
      {%- if g.failOnUnmappableLocations is not none %}<failOnUnmappableLocations>{{ 'true' if g.failOnUnmappableLocations else 'false' }}</failOnUnmappableLocations>{% endif %}
      {%- if g.maxLogWarnings is not none %}<maxLogWarnings>{{ g.maxLogWarnings }}</maxLogWarnings>{% endif %}
      {%- if g.logWarningsToSeparateFile is not none %}<logWarningsToSeparateFile>{{ 'true' if g.logWarningsToSeparateFile else 'false' }}</logWarningsToSeparateFile>{% endif %}
      {%- if g.ignoreFileNotFoundWarnings is not none %}<ignoreFileNotFoundWarnings>{{ 'true' if g.ignoreFileNotFoundWarnings else 'false' }}</ignoreFileNotFoundWarnings>{% endif %}
      {%- if g.idMapId is not none %}<idMapId>{{ g.idMapId }}</idMapId>{% endif %}
      {%- if g.moduleInstanceAware is not none %}<moduleInstanceAware>{{ 'true' if g.moduleInstanceAware else 'false' }}</moduleInstanceAware>{% endif %}
      {%- if g.useStandardName is not none %}<useStandardName>{{ 'true' if g.useStandardName else 'false' }}</useStandardName>{% endif %}
      {%- if g.maximumSnapDistance is not none %}<maximumSnapDistance>{{ g.maximumSnapDistance }}</maximumSnapDistance>{% endif %}
      {%- if g.maximumVerticalSnapDistance is not none %}<maximumVerticalSnapDistance>{{ g.maximumVerticalSnapDistance }}</maximumVerticalSnapDistance>{% elif g.mapLocationsByLayerSigmaCoordinate is not none %}<mapLocationsByLayerSigmaCoordinate>{{ 'true' if g.mapLocationsByLayerSigmaCoordinate else 'false' }}</mapLocationsByLayerSigmaCoordinate>{% endif %}
      {%- if g.unitConversionsId is not none %}<unitConversionsId>{{ g.unitConversionsId }}</unitConversionsId>{% endif %}
      {%- if g.disableImportOnMissingUnitConversion is not none %}<disableImportOnMissingUnitConversion>{{ 'true' if g.disableImportOnMissingUnitConversion else 'false' }}</disableImportOnMissingUnitConversion>{% endif %}
      {%- if g.flagConversionsId is not none %}<flagConversionsId>{{ g.flagConversionsId }}</flagConversionsId>{% endif %}
      {%- if g.flagSourceConversionsId is not none %}<flagSourceConversionsId>{{ g.flagSourceConversionsId }}</flagSourceConversionsId>{% endif %}
      {%- if g.missingValue is not none %}<missingValue>{{ g.missingValue }}</missingValue>{% endif %}
      {%- for m in g.missingValueText %}<missingValueText>{{ m }}</missingValueText>{% endfor %}
      {%- for t in g.traceValue %}<traceValue>{{ t }}</traceValue>{% endfor %}
      {%- if g.importTimeZone is not none %}<importTimeZone>{{ tzone(g.importTimeZone) }}</importTimeZone>{% endif %}
      {%- if g.gridStartPoint is not none %}<gridStartPoint>{{ g.gridStartPoint }}</gridStartPoint>{% endif %}
      {%- if g.geoDatum is not none %}<geoDatum>{{ g.geoDatum }}</geoDatum>{% endif %}
      {%- if g.importTypeConfig is not none %}<importTypeConfig>{{ g.importTypeConfig }}</importTypeConfig>{% endif %}
      {%- if g.dataFeedId is not none %}<dataFeedId>{{ g.dataFeedId }}</dataFeedId>{% elif g.disableDataFeedInfo is not none and g.disableDataFeedInfo %}<disableDataFeedInfo/>{% endif %}
      {%- if g.convertDatum is not none %}<convertDatum>{{ 'true' if g.convertDatum else 'false' }}</convertDatum>{% endif %}
      {%- if g.skipMissingValues is not none %}<skipMissingValues>{{ 'true' if g.skipMissingValues else 'false' }}</skipMissingValues>{% endif %}
      {%- if g.skipEmptyTextValues is not none %}<skipEmptyTextValues>{{ 'true' if g.skipEmptyTextValues else 'false' }}</skipEmptyTextValues>{% endif %}
      {%- if g.ignoreNonExistingLocationSets is not none %}<ignoreNonExistingLocationSets>{{ 'true' if g.ignoreNonExistingLocationSets else 'false' }}</ignoreNonExistingLocationSets>{% endif %}
      {%- if g.reportChangedValues is not none %}<reportChangedValues>{{ 'true' if g.reportChangedValues else 'false' }}</reportChangedValues>{% endif %}
      {%- if g.actionLogEventTypeId is not none %}<actionLogEventTypeId>{{ g.actionLogEventTypeId }}</actionLogEventTypeId>{% endif %}
      {%- if g.comment is not none %}{%- set cm = g.comment %}<comment>{% if cm.dateTimePattern is not none %}<dateTimePattern>{{ cm.dateTimePattern }}</dateTimePattern>{% endif %}{% if cm.timeZone is not none %}<timeZone>{{ tzone(cm.timeZone) }}</timeZone>{% endif %}{% if cm.commentForFirstValue is not none %}<commentForFirstValue>{{ cm.commentForFirstValue }}</commentForFirstValue>{% endif %}{% if cm.commentForAllValues is not none %}<commentForAllValues>{{ cm.commentForAllValues }}</commentForAllValues>{% endif %}</comment>{% endif %}
      {%- if g.synchLevel is not none %}<synchLevel>{{ g.synchLevel }}</synchLevel>{% endif %}
      {%- if g.expiryTime is not none %}{{ tstep(g.expiryTime, "expiryTime") }}{% endif %}
      {%- if g.relativeForecastTime is not none %}<relativeForecastTime value="{{ g.relativeForecastTime.value }}" unit="{{ g.relativeForecastTime.unit }}"/>{% endif %}
      {%- if g.skipFirstLinesCount is not none %}<skipFirstLinesCount>{{ g.skipFirstLinesCount }}</skipFirstLinesCount>{% endif %}
      {%- if g.gotoLineWhichStartsWith is not none %}<gotoLineWhichStartsWith>{{ g.gotoLineWhichStartsWith }}</gotoLineWhichStartsWith>{% endif %}
      {%- if g.commentIgnoreFilter is not none %}{%- set cf = g.commentIgnoreFilter %}<commentIgnoreFilter>{% if cf.ignoreCommentPattern is not none %}<ignoreCommentPattern>{{ cf.ignoreCommentPattern }}</ignoreCommentPattern>{% else %}{% for ic in cf.ignoreComment %}<ignoreComment>{{ ic }}</ignoreComment>{% endfor %}{% endif %}</commentIgnoreFilter>{% endif %}
      {%- if g.ignoreEmptyComments is not none %}<ignoreEmptyComments>{{ 'true' if g.ignoreEmptyComments else 'false' }}</ignoreEmptyComments>{% endif %}
      {%- if g.mergeWithExistingSampleData is not none %}<mergeWithExistingSampleData>{{ 'true' if g.mergeWithExistingSampleData else 'false' }}</mergeWithExistingSampleData>{% endif %}
      {%- if g.rejectCompleteSampleOnUnmappableId is not none %}<rejectCompleteSampleOnUnmappableId>{{ 'true' if g.rejectCompleteSampleOnUnmappableId else 'false' }}</rejectCompleteSampleOnUnmappableId>{% endif %}
      {%- if g.rejectCompleteSampleOnDuplicateValues is not none %}<rejectCompleteSampleOnDuplicateValues>{{ 'true' if g.rejectCompleteSampleOnDuplicateValues else 'false' }}</rejectCompleteSampleOnDuplicateValues>{% endif %}
      {%- if g.overwriteAnnotations is not none %}<overwriteAnnotations>{{ 'true' if g.overwriteAnnotations else 'false' }}</overwriteAnnotations>{% endif %}
      {%- if g.trimPeriodWhenLastImportedTimeStepAfterPeriod is not none %}<trimPeriodWhenLastImportedTimeStepAfterPeriod>{{ 'true' if g.trimPeriodWhenLastImportedTimeStepAfterPeriod else 'false' }}</trimPeriodWhenLastImportedTimeStepAfterPeriod>{% endif %}
      {%- if g.columnSeparator is not none %}<columnSeparator>{{ g.columnSeparator }}</columnSeparator><decimalSeparator>{{ g.decimalSeparator }}</decimalSeparator>{% endif %}
      {%- if g.dateTimePattern is not none %}<dateTimePattern>{{ g.dateTimePattern }}</dateTimePattern>{% endif %}
      {%- if g.charset is not none %}<charset>{{ g.charset }}</charset>{% endif %}
    </general>
{%- endmacro -%}
<?xml version="1.0" encoding="UTF-8"?>
<timeSeriesImportRun xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/timeSeriesImportRun.xsd">
{% for imp in import_ %}
  <import>
    {{ emit_general(imp.general) }}
    {% for tol in imp.tolerance %}<tolerance timeUnit="{{ tol.timeUnit }}" unitCount="{{ tol.unitCount }}" parameterId="{{ tol.parameterId }}"/>{% endfor %}
    {%- for sts in imp.startTimeShift %}
    <startTimeShift>
      {%- if sts.locationSetId is not none %}<locationSetId>{{ sts.locationSetId }}</locationSetId>{% elif sts.locationId is not none %}<locationId>{{ sts.locationId }}</locationId>{% endif %}
      <parameterId>{{ sts.parameterId }}</parameterId>
      {{ relp(sts.relativePeriod, "relativePeriod") }}
    </startTimeShift>
    {%- endfor %}
    {%- if imp.properties is not none %}
    <properties>
      {%- if imp.properties.description is not none %}<description>{{ imp.properties.description }}</description>{% endif %}
      {%- for p in imp.properties.string %}<string key="{{ p.key }}" value="{{ p.value }}"/>{% endfor %}
      {%- for p in imp.properties["int"] %}<int key="{{ p.key }}" value="{{ p.value }}"/>{% endfor %}
      {%- for p in imp.properties["float"] %}<float key="{{ p.key }}" value="{{ p.value }}"/>{% endfor %}
      {%- for p in imp.properties.double %}<double key="{{ p.key }}" value="{{ p.value }}"/>{% endfor %}
      {%- for p in imp.properties["bool"] %}<bool key="{{ p.key }}" value="{{ 'true' if p.value else 'false' }}"/>{% endfor %}
      {%- for p in imp.properties.dateTime %}<dateTime key="{{ p.key }}" date="{{ p.date }}" time="{{ p.time }}"/>{% endfor %}
    </properties>
    {%- endif %}
    {% if imp.temporary is not none %}<temporary>{{ 'true' if imp.temporary else 'false' }}</temporary>
    {%- elif imp.locationId %}{% for l in imp.locationId %}<locationId>{{ l }}</locationId>{% endfor %}
    {%- elif imp.locationSetId is not none %}<locationSetId>{{ imp.locationSetId }}</locationSetId>
    {%- elif imp.annotationLocationSetId is not none %}<annotationLocationSetId>{{ imp.annotationLocationSetId }}</annotationLocationSetId>
    {%- else %}{% for ts in imp.timeSeriesSet %}
    {{ tss.render(ts) }}
    {%- endfor %}{% endif %}
    {% for eu in imp.externUnit %}
    <externUnit parameterId="{{ eu.parameterId }}" unit="{{ eu.unit }}"{% if eu.cumulativeSum %} cumulativeSum="true"{% endif %}{% if eu.cumulativeMean %} cumulativeMean="true"{% endif %}{% if eu.cumulativeSumIgnoreFirstTimeStep %} cumulativeSumIgnoreFirstTimeStep="true"{% endif %}/>
    {%- endfor %}
    {%- for g in imp.gribRecordTimeIgnore %}
    <gribRecordTimeIgnore locationId="{{ g.locationId }}" parameterId="{{ g.parameterId }}" ignore="{{ 'true' if g.ignore else 'false' }}"/>
    {%- endfor %}
    {%- for s in imp.interpolateSerie %}
    <interpolateSerie parameterId="{{ s.parameterId }}" interpolate="{{ 'true' if s.interpolate else 'false' }}"/>
    {%- endfor %}
    {%- if imp.minimumAgeForImport is not none %}
    <minimumAgeForImport unit="{{ imp.minimumAgeForImport.unit }}" multiplier="{{ imp.minimumAgeForImport.multiplier }}"/>
    {%- endif %}
  </import>
{% endfor %}
</timeSeriesImportRun>
