<?xml version="1.0" encoding="UTF-8"?>
<configUpdateModule xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/configUpdateModule.xsd">
  <mapLayerImport{% if mapLayerImport.skipUpdateOnValidationFailure is not none %} skipUpdateOnValidationFailure="{{ 'true' if mapLayerImport.skipUpdateOnValidationFailure else 'false' }}"{% endif %}>
    <importDir>{{ mapLayerImport.importDir }}</importDir>
    <backupDir>{{ mapLayerImport.backupDir }}</backupDir>
    <failedDir>{{ mapLayerImport.failedDir }}</failedDir>
  </mapLayerImport>
</configUpdateModule>
