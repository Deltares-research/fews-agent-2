{%- import "_partials/time_series_filter.xml.j2" as tsf -%}
<?xml version="1.0" encoding="UTF-8"?>
<timeSeriesButtonsPanels xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/timeSeriesButtonsPanels.xsd">
  {%- for p in panel %}
  <panel id="{{ p.id }}">
    <resolveInWorkflow>{{ 'true' if p.resolveInWorkflow else 'false' }}</resolveInWorkflow>
    <resolveInPlots>{{ 'true' if p.resolveInPlots else 'false' }}</resolveInPlots>
    {%- for b in p.button %}
    <button groupId="{{ b.groupId }}"{% if b.name is not none %} name="{{ b.name }}"{% endif %} row="{{ b.row }}" column="{{ b.column }}">
      {%- if b.defaultForTopologyNodeIdPattern is not none %}
      <defaultForTopologyNodeIdPattern>{{ b.defaultForTopologyNodeIdPattern }}</defaultForTopologyNodeIdPattern>
      {%- endif %}
      {%- if b.toolTip is not none %}
      <toolTip>{{ b.toolTip }}</toolTip>
      {%- endif %}
    {{ tsf.body(b.filter) }}
    </button>
    {%- endfor %}
  </panel>
  {%- endfor %}
</timeSeriesButtonsPanels>
