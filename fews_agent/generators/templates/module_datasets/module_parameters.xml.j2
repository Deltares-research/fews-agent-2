<?xml version="1.0" encoding="UTF-8"?>
<parameters xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.wldelft.nl/fews/PI" xsi:schemaLocation="http://www.wldelft.nl/fews/PI http://fews.wldelft.nl/schemas/version1.0/pi-schemas/pi_modelparameters.xsd" version="{{ version }}">
  {% if modifierType is not none %}<modifierType>{{ modifierType }}</modifierType>{% endif %}
{% for g in group %}
  <group id="{{ g.id }}"{% if g.name is not none %} name="{{ g.name }}"{% endif %}>
    {% if g.model is not none %}<model>{{ g.model }}</model>{% endif %}
    {% for p in g.parameter %}
    <parameter id="{{ p.id }}">
      {% if p.boolValue is not none %}<boolValue>{{ p.boolValue }}</boolValue>{% endif %}
      {% if p.stringValue is not none %}<stringValue>{{ p.stringValue }}</stringValue>{% endif %}
      {% if p.doubleValue is not none %}<doubleValue>{{ p.doubleValue }}</doubleValue>{% endif %}
      {% if p.intValue is not none %}<intValue>{{ p.intValue }}</intValue>{% endif %}
    </parameter>
    {% endfor %}
  </group>
{% endfor %}
</parameters>
