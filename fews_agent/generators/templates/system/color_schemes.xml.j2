<?xml version="1.0" encoding="UTF-8"?>
<schemes xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/colorSchemes.xsd"{% if version is not none %} version="{{ version }}"{% endif %}>
{% for s in scheme %}
  <scheme name="{{ s.name }}">
    <predefinedColorKeys>
      {%- for key in predefined_order %}
        {%- if key in s.predefinedColorKeys %}
          {%- set color = s.predefinedColorKeys[key] %}
          {%- if color is none %}
      <{{ key }}/>
          {%- else %}
      <{{ key }} color="{{ color }}"/>
          {%- endif %}
        {%- endif %}
      {%- endfor %}
    </predefinedColorKeys>
    {% if s.customColorKeys %}
    <customColorKeys>
      {% for k in s.customColorKeys %}<key key="{{ k.key }}"{% if k.color is not none %} color="{{ k.color }}"{% endif %}/>{% endfor %}
    </customColorKeys>
    {% endif %}
  </scheme>
{% endfor %}
</schemes>
