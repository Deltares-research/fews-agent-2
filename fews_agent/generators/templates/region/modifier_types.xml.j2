<?xml version="1.0" encoding="utf-8"?>
<modifierTypes xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/modifierTypes.xsd">
  {% if restoreModifiersWhenApprovingForecastRun is not none %}<restoreModifiersWhenApprovingForecastRun>{{ 'true' if restoreModifiersWhenApprovingForecastRun else 'false' }}</restoreModifiersWhenApprovingForecastRun>{% endif %}
  {% if rollbackOverlappingModifiers is not none %}<rollbackOverlappingModifiers>{{ 'true' if rollbackOverlappingModifiers else 'false' }}</rollbackOverlappingModifiers>{% endif %}
  {% if autoCommit is not none %}<autoCommit>{{ 'true' if autoCommit else 'false' }}</autoCommit>{% endif %}
  {% if autoExtendExpiryTime is not none %}<autoExtendExpiryTime>{{ 'true' if autoExtendExpiryTime else 'false' }}</autoExtendExpiryTime>{% endif %}
{% for m in timeSeriesModifier %}
  <timeSeriesModifier id="{{ m.id }}"{% if m.name is not none %} name="{{ m.name }}"{% endif %}>
    {% if m.modifierTypeDescription is not none %}<modifierTypeDescription>{{ m.modifierTypeDescription }}</modifierTypeDescription>{% endif %}
    {% if m.expiryTime is not none %}<expiryTime unit="{{ m.expiryTime.unit }}"{% if m.expiryTime.multiplier is not none %} multiplier="{{ m.expiryTime.multiplier }}"{% endif %}/>{% endif %}
    {% if m.expiryTimeDeletedModifiers is not none %}<expiryTimeDeletedModifiers unit="{{ m.expiryTimeDeletedModifiers.unit }}"{% if m.expiryTimeDeletedModifiers.multiplier is not none %} multiplier="{{ m.expiryTimeDeletedModifiers.multiplier }}"{% endif %}/>{% endif %}
    {% if m.modifierCardinalTimeStep is not none %}{{ m.modifierCardinalTimeStep | dict_to_xml('modifierCardinalTimeStep') | safe }}{% endif %}
    {% for u in m.userDefinedDescriptionField %}{{ u | dict_to_xml('userDefinedDescriptionField') | safe }}{% endfor %}
    {% if m.whatIfModifierType is not none %}<whatIfModifierType>{{ m.whatIfModifierType }}</whatIfModifierType>{% endif %}
    {% if m.createPermission is not none %}<createPermission>{{ m.createPermission }}</createPermission>{% endif %}
    {% if m.useLocationLongName is not none %}<useLocationLongName>{{ 'true' if m.useLocationLongName else 'false' }}</useLocationLongName>{% endif %}
    {% if m.applyToDeterministicRun is not none %}<applyToDeterministicRun>{{ 'true' if m.applyToDeterministicRun else 'false' }}</applyToDeterministicRun>{% endif %}
    {% for a in m.applyToEnsemble %}<applyToEnsemble>{{ a }}</applyToEnsemble>{% endfor %}
    <timeSeries>
      <moduleInstanceId>{{ m.timeSeries.moduleInstanceId }}</moduleInstanceId>
      <valueType>{{ m.timeSeries.valueType }}</valueType>
      <parameterId>{{ m.timeSeries.parameterId }}</parameterId>
      {% if m.timeSeries.locationId is not none %}<locationId>{{ m.timeSeries.locationId }}</locationId>{% endif %}
      {% if m.timeSeries.locationSetId is not none %}<locationSetId>{{ m.timeSeries.locationSetId }}</locationSetId>{% endif %}
    </timeSeries>
    {% if m.onlyApplyLastModifier is not none %}<onlyApplyLastModifier>{{ 'true' if m.onlyApplyLastModifier else 'false' }}</onlyApplyLastModifier>{% endif %}
    {% if m.mergeUnCommittedModifiers is not none %}<mergeUnCommittedModifiers>{{ 'true' if m.mergeUnCommittedModifiers else 'false' }}</mergeUnCommittedModifiers>{% endif %}
    {% for r in m.referenceTimeSeries %}{{ r | dict_to_xml('referenceTimeSeries') | safe }}{% endfor %}
    {% if m.softLimits is not none %}{{ m.softLimits | dict_to_xml('softLimits') | safe }}{% endif %}
    {% if m.hardLimits is not none %}{{ m.hardLimits | dict_to_xml('hardLimits') | safe }}{% endif %}
    {% if m.defaultStartTime is not none %}<defaultStartTime>{{ m.defaultStartTime }}</defaultStartTime>{% endif %}
    {% if m.defaultEndTime is not none %}<defaultEndTime>{{ m.defaultEndTime }}</defaultEndTime>{% endif %}
    {% if m.defaultValidTime %}<defaultValidTime/>{% endif %}
    {% if m.resolveInWorkflow is not none %}<resolveInWorkflow>{{ 'true' if m.resolveInWorkflow else 'false' }}</resolveInWorkflow>{% endif %}
    {% if m.resolveInPlots is not none %}<resolveInPlots>{{ 'true' if m.resolveInPlots else 'false' }}</resolveInPlots>{% endif %}
    {% if m.editInPlots is not none %}<editInPlots>{{ 'true' if m.editInPlots else 'false' }}</editInPlots>{% elif m.graphicalEditing is not none %}<graphicalEditing>{{ 'true' if m.graphicalEditing else 'false' }}</graphicalEditing>{% endif %}
    {% if m.perEnsembleMember is not none %}<perEnsembleMember>{{ 'true' if m.perEnsembleMember else 'false' }}</perEnsembleMember>{% endif %}
    {% if m.createContinuousModifiers is not none %}<createContinuousModifiers>{{ 'true' if m.createContinuousModifiers else 'false' }}</createContinuousModifiers>{% endif %}
  </timeSeriesModifier>
{% endfor %}
{% for m in spatialCopyModifier %}
  <spatialCopyModifier id="{{ m.id }}"{% if m.name is not none %} name="{{ m.name }}"{% endif %}>
    {% if m.modifierTypeDescription is not none %}<modifierTypeDescription>{{ m.modifierTypeDescription }}</modifierTypeDescription>{% endif %}
    {% if m.expiryTime is not none %}<expiryTime unit="{{ m.expiryTime.unit }}" multiplier="{{ m.expiryTime.multiplier }}"/>{% endif %}
    {% if m.expiryTimeDeletedModifiers is not none %}<expiryTimeDeletedModifiers unit="{{ m.expiryTimeDeletedModifiers.unit }}"{% if m.expiryTimeDeletedModifiers.multiplier is not none %} multiplier="{{ m.expiryTimeDeletedModifiers.multiplier }}"{% endif %}/>{% endif %}
    {% if m.modifierCardinalTimeStep is not none %}{{ m.modifierCardinalTimeStep | dict_to_xml('modifierCardinalTimeStep') | safe }}{% endif %}
    {% for u in m.userDefinedDescriptionField %}{{ u | dict_to_xml('userDefinedDescriptionField') | safe }}{% endfor %}
    {% if m.whatIfModifierType is not none %}<whatIfModifierType>{{ m.whatIfModifierType }}</whatIfModifierType>{% endif %}
    {% if m.createPermission is not none %}<createPermission>{{ m.createPermission }}</createPermission>{% endif %}
    {% for ts in m.timeSeries %}
    <timeSeries>
      <moduleInstanceId>{{ ts.moduleInstanceId }}</moduleInstanceId>
      <parameterId>{{ ts.parameterId }}</parameterId>
      <locationId>{{ ts.locationId }}</locationId>
    </timeSeries>
    {% endfor %}
  </spatialCopyModifier>
{% endfor %}
{% for m in spatialProfileModifier %}
  <spatialProfileModifier id="{{ m.id }}"{% if m.name is not none %} name="{{ m.name }}"{% endif %}>
    {% if m.modifierTypeDescription is not none %}<modifierTypeDescription>{{ m.modifierTypeDescription }}</modifierTypeDescription>{% endif %}
    {% if m.expiryTime is not none %}<expiryTime unit="{{ m.expiryTime.unit }}" multiplier="{{ m.expiryTime.multiplier }}"/>{% endif %}
    {% if m.expiryTimeDeletedModifiers is not none %}<expiryTimeDeletedModifiers unit="{{ m.expiryTimeDeletedModifiers.unit }}"{% if m.expiryTimeDeletedModifiers.multiplier is not none %} multiplier="{{ m.expiryTimeDeletedModifiers.multiplier }}"{% endif %}/>{% endif %}
    {% if m.modifierCardinalTimeStep is not none %}{{ m.modifierCardinalTimeStep | dict_to_xml('modifierCardinalTimeStep') | safe }}{% endif %}
    {% if m.userDefinedDescriptionField is not none %}<userDefinedDescriptionField id="{{ m.userDefinedDescriptionField.id }}" descriptionField="{{ m.userDefinedDescriptionField.descriptionField }}"/>{% endif %}
    {% if m.whatIfModifierType is not none %}<whatIfModifierType>{{ m.whatIfModifierType }}</whatIfModifierType>{% endif %}
    {% if m.createPermission is not none %}<createPermission>{{ m.createPermission }}</createPermission>{% endif %}
    {% for ts in m.timeSeries %}
    <timeSeries>
      <moduleInstanceId>{{ ts.moduleInstanceId }}</moduleInstanceId>
      <parameterId>{{ ts.parameterId }}</parameterId>
    </timeSeries>
    {% endfor %}
    {% if m.descriptiveFunctionGroups is not none %}
    <descriptiveFunctionGroups>
      {% for g in m.descriptiveFunctionGroups.descriptiveFunctionGroup %}
      <descriptiveFunctionGroup name="{{ g.name }}">
        {% for df in g.descriptiveFunction %}
        {% if df.timeSpan %}<descriptiveFunction function="{{ df.function }}"{% if df.ignoreMissings is not none %} ignoreMissings="{{ 'true' if df.ignoreMissings else 'false' }}"{% endif %}>
          {% for sp in df.timeSpan %}<timeSpan unit="{{ sp.unit }}" multiplier="{{ sp.multiplier }}"/>{% endfor %}
        </descriptiveFunction>
        {% else %}<descriptiveFunction function="{{ df.function }}"{% if df.ignoreMissings is not none %} ignoreMissings="{{ 'true' if df.ignoreMissings else 'false' }}"{% endif %}/>{% endif %}
        {% endfor %}
      </descriptiveFunctionGroup>
      {% endfor %}
    </descriptiveFunctionGroups>
    {% endif %}
  </spatialProfileModifier>
{% endfor %}
{% for g in modifiersGroup %}
  <modifiersGroup id="{{ g.id }}">
    {% for mid in g.modifierId %}<modifierId>{{ mid }}</modifierId>{% endfor %}
  </modifiersGroup>
{% endfor %}
{%- for kind in ['missingValueModifier', 'typicalProfileModifier',
                 'constantValueModifier', 'singleValueModifier', 'enumerationModifier',
                 'markUnreliableModifier', 'adjustQModifiers',
                 'timeShiftConstantModifiers', 'sampleHistoricalModifiers',
                 'mergeSimpleModifiers', 'compoundModifier',
                 'highLowSurgeSelectionModifier', 'switchOptionModifier',
                 'optionModifier', 'moduleParameterModifier', 'priorityModifier',
                 'multipleModuleParameterModifier', 'unitHydrographModifiers',
                 'mergeWeightedModifiers', 'ratingCurveModifiers',
                 'attributeModifiers', 'copyModifiers'] %}
{%- set entries = _root[kind] %}
{%- for m in entries %}
  {{ {kind: m} | dict_to_xml | safe }}
{%- endfor %}
{%- endfor %}
</modifierTypes>
