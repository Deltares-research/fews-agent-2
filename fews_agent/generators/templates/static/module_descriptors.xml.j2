<?xml version="1.0" encoding="UTF-8"?>
<moduleDescriptors version="{{ version }}" xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/moduleDescriptors.xsd">
{% for m in moduleDescriptor %}
  <moduleDescriptor id="{{ m.id }}"{% if m.name is not none %} name="{{ m.name }}"{% endif %}>
    {% if m.description is not none %}<description>{{ m.description }}</description>{% endif %}
    <className>{{ m.className }}</className>
  </moduleDescriptor>
{% endfor %}
</moduleDescriptors>
