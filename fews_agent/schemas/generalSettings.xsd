<?xml version="1.0" encoding="UTF-8"?>
<!--Delft FEWS (Copyright 2003 WL | Delft Hydraulics) -->
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:fews="http://www.wldelft.nl/fews" targetNamespace="http://www.wldelft.nl/fews" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<include schemaLocation="sharedTypes.xsd"/>
	<!--This file contains general configurable options for the FEWS system. -->
	<element name="generalSettings" type="fews:GeneralSettingsComplexType"/>
	<complexType name="GeneralSettingsComplexType">
		<sequence>
            <element name="stateSettings" type="fews:StateSettingsComplexType" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="StateSettingsComplexType">
		<annotation>
			<documentation>Settings for configuring state information</documentation>
		</annotation>
		<sequence>
            <element name="defaultWarmStateSearchPeriod" type="fews:RelativePeriodComplexType" minOccurs="0">
                <annotation>
                    <documentation>General default warm state search period.</documentation>
                </annotation>
            </element>
            <element name="defaultForecastLength" type="fews:TimeSpanComplexType" minOccurs="0">
                <annotation>
                    <documentation>General default forecast length.</documentation>
                </annotation>
            </element>
		</sequence>
	</complexType>
</schema>
