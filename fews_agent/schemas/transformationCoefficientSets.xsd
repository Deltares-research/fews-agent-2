<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:fews="http://www.wldelft.nl/fews" targetNamespace="http://www.wldelft.nl/fews" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<include schemaLocation="transformationTypes.xsd"/>
	<include schemaLocation="sharedTypes.xsd"/>
	<element name="transformationCoefficientSets" type="fews:TransformationCoefficientSetsComplexType">
		<annotation>
			<documentation>List of transformation coefficient sets.</documentation>
		</annotation>
	</element>
	<complexType name="TransformationCoefficientSetsComplexType">
		<sequence>
			<element name="timeZone" type="fews:timeZoneStringType" minOccurs="0">
				<annotation>
					<documentation>Optional time zone for dates and times defined in this configuration file. If no time zone is defined, then dates and times are in GMT.</documentation>
				</annotation>
			</element>
			<element name="coefficientSet" type="fews:TransformationCoefficientSetComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>One or more sets of coefficients. Each set has an identifier to reference to that set.</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="version" type="fews:versionStringType" use="required" fixed="1.0">
			<annotation>
				<documentation>Schema version.</documentation>
			</annotation>
		</attribute>
	</complexType>
	<complexType name="TransformationCoefficientSetComplexType">
		<choice>
			<group ref="fews:CoefficientSetChoiceGroup">
				<annotation>
					<documentation>One or more sets of coefficients of a given type that are valid for different ranges of a certain limit variable. Ranges should not overlap.</documentation>
				</annotation>
			</group>
			<element name="periodCoefficientSet" type="fews:PeriodDependentCoefficientSetComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>One or more sets that are valid for different periods and contain multiple sets of coefficients that are valid for different ranges.</documentation>
				</annotation>
			</element>
			<element name="locationCoefficientSet" type="fews:LocationDependentCoefficientSetComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>One or more sets that are valid for different locations and contain multiple sets of coefficients that are valid for different periods and/or ranges.</documentation>
				</annotation>
			</element>
		</choice>
		<attribute name="id" type="fews:idStringType" use="required">
			<annotation>
				<documentation>Identifier of this set of coefficients.</documentation>
			</annotation>
		</attribute>
	</complexType>
	<complexType name="PeriodDependentCoefficientSetComplexType">
		<annotation>
			<documentation>One or more sets that are valid for different periods and contain multiple sets of coefficients that are valid for different ranges.</documentation>
		</annotation>
		<sequence>
			<element name="period" type="fews:PeriodConditionComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>One or more periods for which this coefficient set is valid. Periods should not overlap. For a period the start time is inclusive and the end time is exclusive.</documentation>
				</annotation>
			</element>
			<group ref="fews:CoefficientSetChoiceGroup">
				<annotation>
					<documentation>One or more sets of coefficients of a given type that are valid for different ranges of a certain limit variable. Ranges should not overlap.</documentation>
				</annotation>
			</group>
		</sequence>
	</complexType>
	<complexType name="LocationDependentCoefficientSetComplexType">
		<sequence>
			<element name="location" type="fews:LocationConditionComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>One or more locations for which this coefficient set is valid. A given location should not be used more than once.</documentation>
				</annotation>
			</element>
			<choice>
				<group ref="fews:CoefficientSetChoiceGroup">
					<annotation>
						<documentation>One or more sets of coefficients of a given type that are valid for different ranges of a certain limit variable. Ranges should not overlap.</documentation>
					</annotation>
				</group>
				<element name="periodCoefficientSet" type="fews:PeriodDependentCoefficientSetComplexType" maxOccurs="unbounded">
					<annotation>
						<documentation>One or more sets that are valid for different periods and contain multiple sets of coefficients that are valid for different ranges.</documentation>
					</annotation>
				</element>
			</choice>
		</sequence>
	</complexType>
	<complexType name="LocationConditionComplexType">
		<sequence>
			<element name="locationId" type="fews:idStringType">
				<annotation>
					<documentation>Identifier of this location.</documentation>
				</annotation>
			</element>
			<element name="locationName" type="fews:nameStringType" minOccurs="0">
				<annotation>
					<documentation>Name of this location. This is not used and is only present for convenience.</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
</schema>
