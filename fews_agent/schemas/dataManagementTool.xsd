<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:fews="http://www.wldelft.nl/fews/archive"
		targetNamespace="http://www.wldelft.nl/fews/archive" elementFormDefault="qualified"
		attributeFormDefault="unqualified" version="1.0">
	<include schemaLocation="archive_sharedTypes.xsd"/>
	<element name="dataManagementTool" type="fews:DataManagementComplexType"/>
	<complexType name="DataManagementComplexType">
		<sequence>
			<element name="outputFile" type="fews:fileStringType">
				<annotation>
					<documentation>Since 2017.02. The result of the analysis, a list of expired datasets, will be written to this file</documentation>
				</annotation>
			</element>
			<element name="numberOfDataSetsLimit" type="positiveInteger" minOccurs="0">
				<annotation>
					<documentation>Since 2023.01. The maximum amount of data sets in a single output file. If there more data sets then the maximum then aditional outputfiles will be written with the
						format outputfile_n.csv (outputfile_1.csv)
					</documentation>
				</annotation>
			</element>
			<element name="backupFolder" type="fews:fileStringType" minOccurs="0">
				<annotation>
					<documentation>Since 2017.02. The task "remove data from archive" will move the files from the archive to this folder.</documentation>
				</annotation>
			</element>
			<element name="eventsFolder" type="fews:directoryStringType" minOccurs="0">
				<annotation>
					<documentation>The events of the archive are stored in a folder. Each area will have a sub-folder in this folder. The data management tool uses the event information to determine
						which data sets are expired.
					</documentation>
				</annotation>
			</element>
			<element name="archiveConfigFolder" type="fews:directoryStringType" minOccurs="0">
				<annotation>
					<documentation>The folder which contains the config for the archive.</documentation>
				</annotation>
			</element>
			<element name="lifeTimeRules" type="fews:RuleComplexType" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<complexType name="RuleComplexType">
		<sequence>
			<element name="basePath" type="fews:directoryStringType" minOccurs="0">
				<annotation>
					<documentation>By the default the base path is equal to the base folder of the archive. However it is possible to define rule per sub folder. In this case the base path can
						overrule the base path of the archive.
					</documentation>
				</annotation>
			</element>
			<element name="defaultLifeTime" type="fews:CalendarTimeSpanComplexType">
				<annotation>
					<documentation>The life time which will be applied when it is not possible to find more specific life time rule in the config.</documentation>
				</annotation>
			</element>
			<element name="defaultAction" type="string" minOccurs="0">
				<annotation>
					<documentation>The action which will be applied when it is not possible to find more specific life time rule in the config. This action is a custom action and will not be used by
						the RemoveDataFromArchiveTask.
					</documentation>
				</annotation>
			</element>
			<element name="lifeTimeSimulatedDataSets" type="fews:TimeSeriesLifeTimeComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>Multiple lifeTimeSimulatedDataSets can be defined for different source ids, only 1 lifeTimeSimulatedDataSets can be defined without source id.</documentation>
				</annotation>
			</element>
			<element name="lifeTimeObservedDataSets" type="fews:TimeSeriesLifeTimeComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>Multiple lifeTimeObservedDataSets can be defined for different source ids, only 1 lifeTimeObservedDataSets can be defined without source id.</documentation>
				</annotation>
			</element>
			<element name="lifeTimeExternalForecastDataSets" type="fews:TimeSeriesLifeTimeComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Multiple lifeTimeExternalForecastDataSets can be defined for different source ids, only 1 lifeTimeExternalForecastDataSets can be defined without source id.
					</documentation>
				</annotation>
			</element>
			<element name="lifeTimeMessagesDataSets" type="fews:LifeTimeComplexType" minOccurs="0">
				<annotation>
					<documentation>The archive can store FEWS messages. At the moment the only messages supported are the forecaster notes. This element can be used to configure a single life time
						rule for all messsages data sets.
					</documentation>
				</annotation>
			</element>
			<element name="lifeTimeConfigurationDataSets" type="fews:LifeTimeComplexType" minOccurs="0">
				<annotation>
					<documentation>This element can be used to configure a single life time rule for the configuration data sets.</documentation>
				</annotation>
			</element>
			<element name="lifeTimeRatingCurveDataSets" type="fews:LifeTimeComplexType" minOccurs="0">
				<annotation>
					<documentation>This element can be used to configure a single life time rule for the rating curve data sets.</documentation>
				</annotation>
			</element>
			<element name="lifeTimeProductDataSets" type="fews:ProductLifeTimeComplexType" minOccurs="0">
				<annotation>
					<documentation>Since 2017.02. This element can be used to configure a single life time rule for the product data sets.</documentation>
				</annotation>
			</element>
			<element name="lifeTimeSnapShotDataSets" type="fews:LifeTimeComplexType" minOccurs="0">
				<annotation>
					<documentation>Since 2017.02. This element can be used to configure a single life time rule for the snapshots.</documentation>
				</annotation>
			</element>
			<element name="lifeTimeLogFilesDataSets" type="fews:LifeTimeComplexType" minOccurs="0">
				<annotation>
					<documentation>Since 2018.02. This element can be used to configure a single life time rule for a data set containing log messages</documentation>
				</annotation>
			</element>

			<element name="eventRule" type="fews:EventRuleComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Data sets which are part of an event can have a different life time than the regular life time. It is possible to define a life time for each event type.
					</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="EventRuleComplexType">
		<sequence>
			<element name="eventTypeId" type="fews:idStringType"/>
			<element name="lifeTime" type="fews:CalendarTimeSpanComplexType"/>
		</sequence>
	</complexType>
	<complexType name="ProductAttributeLifeTimeComplexType">
		<sequence>
			<element name="attribute" type="fews:AttributeComplexType"/>
			<element name="lifeTime" type="fews:CalendarTimeSpanComplexType"/>
			<element name="action" type="string" minOccurs="0">
				<annotation>
					<documentation>This action is for custom purposes only. It can be used when the output of the this task is used by a custom tool. It is not used by the remove data from archive
						task.
					</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="ProductLifeTimeComplexType">
		<complexContent>
			<extension base="fews:LifeTimeComplexType">
				<sequence>
					<element name="attributeDefinedLifeTime" type="fews:ProductAttributeLifeTimeComplexType" minOccurs="0" maxOccurs="unbounded">
						<annotation>
							<documentation>Define the value of an attribute to make the life time specific for certain attribute value</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="LifeTimeComplexType">
		<sequence>
			<element name="lifeTime" type="fews:CalendarTimeSpanComplexType"/>
			<element name="action" type="string" minOccurs="0">
				<annotation>
					<documentation>This action is for custom purposes only. It can be used when the output of the this task is used by a custom tool. It is not used by the remove data from archive
						task.
					</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="TimeSeriesLifeTimeComplexType">
		<complexContent>
			<extension base="fews:LifeTimeComplexType">
				<sequence>
					<element name="sourceId" type="string" minOccurs="0">
						<annotation>
							<documentation>This action is for custom purposes only. It can be used when the output of the this task is used by a custom tool. It is not used by the remove data from
								archive
								task.
							</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
</schema>
