<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:fews="http://www.wldelft.nl/fews" targetNamespace="http://www.wldelft.nl/fews" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<include schemaLocation="sharedTypes.xsd"/>
	<element name="storageBasin" type="fews:StorageBasinComplexType"/>
	<complexType name="StorageBasinComplexType">
		<sequence>
			<element name="elevationStorageTable" type="fews:ElevationStorageTableComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>Area in square meters of this storage basin</documentation>
				</annotation>
			</element>
			<element name="structure" type="fews:StructureCompextType" maxOccurs="unbounded">
				<annotation>
					<documentation>List of structures present in this storage basin</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="id" type="string" use="required"/>
		<attribute name="name" type="string" use="optional"/>
	</complexType>
	<complexType name="PumpStateComplexType">
		<choice>
			<element name="constantDischarge" type="fews:ConstantDischargeComplexType">
				<annotation>
					<documentation>Constant discharge pumping state. Discharge is not dependant on any other factor</documentation>
				</annotation>
			</element>
		</choice>
		<attribute name="id" type="int" use="required"/>
	</complexType>
	<complexType name="ConstantDischargeComplexType">
		<sequence>
			<element name="discharge" type="float">
				<annotation>
					<documentation>Discharge in m3/sec. Negative values indicate a discharge in upstream direction. Positive values in a downstream direction.</documentation>
				</annotation>
			</element>
			<element name="description" type="string" minOccurs="0">
				<annotation>
					<documentation>Descriptive information about pumping state</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="PumpingStationComplexTypeType">
		<sequence>
			<element name="pumpState" type="fews:PumpStateComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>List of available pumping states for this pumping station</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="id" type="string" use="required"/>
		<attribute name="name" type="string" use="optional"/>
		<attribute name="minimumDeploymentTime" type="int" use="optional">
			<annotation>
				<documentation source="Minimum deployment time in hours."/>
			</annotation>
		</attribute>
		<attribute name="switchOfLevel" type="float" use="optional">
			<annotation>
				<documentation source="Minimum allowed water level before structure switches off. (m NAP)"/>
			</annotation>
		</attribute>
		<attribute name="switchOnLevel" type="float" use="optional">
			<annotation>
				<documentation source="Level above which this structure must switch on (if possible). (m NAP)"/>
			</annotation>
		</attribute>
		<attribute name="alarmLevel" type="float" use="optional">
			<annotation>
				<documentation source="Level above which alarm is to be generated. (m NAP)"/>
			</annotation>
		</attribute>
	</complexType>
	<complexType name="StructureCompextType">
		<choice>
			<element name="pumpingStation" type="fews:PumpingStationComplexTypeType">
				<annotation>
					<documentation>Structure of type Pumping station</documentation>
				</annotation>
			</element>
		</choice>
	</complexType>
</schema>
