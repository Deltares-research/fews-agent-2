<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns:fews="http://www.wldelft.nl/fews" xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.wldelft.nl/fews" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<include schemaLocation="sharedTypes.xsd"/>
	<!-- -->
	<element name="fewsAdapterLauncher" type="fews:FewsAdapterLauncherComplexType"/>
	<complexType name="FewsAdapterLauncherComplexType">
		<sequence>
			<element name="description" type="string" minOccurs="0"/>
			<element name="workingDir" type="fews:fileStringType"/>
			<element name="splashPictureFile" type="fews:fileStringType"/>
			<element name="executeActivity" type="fews:ExecuteActivityComplexType" maxOccurs="unbounded"/>
			<element name="logConfigFile" type="fews:fileStringType" minOccurs="0">
				<annotation>
					<documentation>log Config file</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
</schema>
