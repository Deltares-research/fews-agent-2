<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:fews="http://www.wldelft.nl/fews" targetNamespace="http://www.wldelft.nl/fews" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<include schemaLocation="sharedTypes.xsd"/>
	<element name="verificationAnalysisDisplay" type="fews:VerificationAnalysisDisplayComplexType"/>
	<complexType name="VerificationAnalysisDisplayComplexType">
		<sequence>
			<element name="viewPeriod" type="fews:RelativePeriodComplexType">
				<annotation>
					<documentation>Relative view period</documentation>
				</annotation>
			</element>
			<element name="dateTimeFormat" type="fews:nonEmptyStringType">
				<annotation>
					<documentation>Format date and time used in display. This can be e.g. "yyyy-MM-dd HH:mm:ss".</documentation>
				</annotation>
			</element>
			<element name="floodPeriodModuleConfigFileName" type="fews:nonEmptyStringType">
				<annotation>
					<documentation>Name of the FloodPeriodModule configuration that will be used to determine Flood Locations</documentation>
				</annotation>
			</element>
			<element name="floodPeriodArchiveEventTypeId" type="fews:idStringType" minOccurs="0" maxOccurs="1">
				<annotation>
					<documentation>Configure the archive event type id that is used to export flood periods to the open archive.</documentation>
				</annotation>
			</element>
			<element name="floodEventArchiveEventTypeId" type="fews:idStringType" minOccurs="0" maxOccurs="1">
				<annotation>
					<documentation>Configure the archive event type id that is used to export flood events to the open archive.</documentation>
				</annotation>
			</element>
			<element name="showAllFloodPeriodsTopologyNodeId" type="fews:idStringType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Configure topology node ids of Forecast Tree Nodes that should show all flood periods.</documentation>
				</annotation>
			</element>
			<element name="showDataTab" type="fews:VerificationAnalysisDataTabComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Show time series based on relative view period and time series set</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="VerificationAnalysisDataTabComplexType">
		<sequence>
			<element name="filterAttributeId" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>Attribute on which time series can be filtered</documentation>
				</annotation>
			</element>
			<element name="selectionFilter" type="fews:SelectionFilterComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Selection based on attributes of the location(s) from the IFD on which the top location table will be filtered</documentation>
				</annotation>
			</element>
			<element name="locationValuePropertyCountColumn" type="fews:ValuePropertyCountColumnComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Value property with specific value for which all occurrences should be counted</documentation>
				</annotation>
			</element>
			<element name="locationValuePropertyMaxColumn" type="fews:ValuePropertyMaxColumnComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Column that shows the maximum value for a value property of all time series for a location</documentation>
				</annotation>
			</element>
			<group ref="fews:VADColumnChoice"  maxOccurs="unbounded"/>
			<element name="timeSeriesSet" type="fews:TimeSeriesSetComplexType" >
				<annotation>
					<documentation>Time series for display</documentation>
				</annotation>
			</element>
			<element name="connectedTimeSeries" type="fews:ConnectedTimeSeriesComplexType" minOccurs="0">
				<annotation>
					<documentation>Time series to match selected location based on same attribute value</documentation>
				</annotation>
			</element>
			<element name="plotTimeSeriesSet" type="fews:TimeSeriesSetComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Time series to show in the TSD, filtered by the selected location.</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="name" type="fews:nonEmptyStringType" use="required"/>
	</complexType>
	<group name="VADColumnChoice">
		<choice>
			<element name="locationIdColumn" type="fews:VADLocationColumnComplexType">
				<annotation>
					<documentation>Column to be shown for location id</documentation>
				</annotation>
			</element>
			<element name="locationNameColumn" type="fews:VADLocationColumnComplexType">
				<annotation>
					<documentation>Column to be shown for location name</documentation>
				</annotation>
			</element>
			<element name="forecastTimeColumn" type="fews:VADLocationColumnComplexType">
				<annotation>
					<documentation>Column to be shown for external forecast time</documentation>
				</annotation>
			</element>
			<element name="forecastValueColumn" type="fews:VADLocationColumnComplexType">
				<annotation>
					<documentation>Column to be shown for the value of the forecast</documentation>
				</annotation>
			</element>
			<element name="forecastLowerValueColumn" type="fews:VADLocationColumnComplexType">
				<annotation>
					<documentation>Column to be shown for the minimum value of the forecast</documentation>
				</annotation>
			</element>
			<element name="forecastUpperValueColumn" type="fews:VADLocationColumnComplexType">
				<annotation>
					<documentation>Column to be shown for the maximum value of the forecast</documentation>
				</annotation>
			</element>
			<element name="forecastPredictionTimeColumn" type="fews:VADLocationColumnComplexType">
				<annotation>
					<documentation>Column to be shown for the time belonging to the forecast value</documentation>
				</annotation>
			</element>
			<element name="valuePropertyColumn" type="fews:ValuePropertyColumnComplexType">
				<annotation>
					<documentation>Column to be shown for time series containing the value of specified value property</documentation>
				</annotation>
			</element>
		</choice>
	</group>
	<complexType name="ValuePropertyColumnComplexType">
		<sequence >
			<element name="enumerationValue" type="string" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Different possible values for this property, when 1 or more enumeration values are defined the column will become editable through a dropdown.</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="valuePropertyId" type="fews:nonEmptyStringType" use="required"/>
		<attribute name="propertyType" type="fews:propertyTypeEnumStringType"/>
		<attribute name="name" type="string"/>
		<attribute name="editable" type="boolean"/>
		<attribute name="width" type="fews:positiveInteger"/>
	</complexType>
	<complexType name="VADLocationColumnComplexType">
		<attribute name="name" type="string"/>
		<attribute name="width" type="fews:positiveInteger"/>
	</complexType>
	<complexType name="ValuePropertyCountColumnComplexType">
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="value" type="string" use="required"/>
		<attribute name="name" type="string" use="required"/>
	</complexType>
	<complexType name="ValuePropertyMaxColumnComplexType">
		<sequence>
			<element name="value" type="string" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Lists the possible values of a value property in descending order.</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="name" type="string" use="required"/>
	</complexType>
	<complexType name="ConnectedTimeSeriesComplexType">
		<sequence>
			<element name="matchingAttributeId" type="fews:idStringType">
				<annotation>
					<documentation>Id of attribute for which the value of the connected time series must match the value of the selected location in the first table</documentation>
				</annotation>
			</element>
			<group ref="fews:VADColumnChoice"  maxOccurs="unbounded"/>
			<element name="connectedTimeSeriesSet" type="fews:TimeSeriesSetComplexType">
				<annotation>
					<documentation>Time series for displaying in 3rd table</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="SelectionFilterComplexType">
		<attribute name="matchingAttributeId" type="fews:idStringType"/>
		<attribute name="matchingAttributeValue" type="string"/>
		<attribute name="selectedAttributeId" type="fews:idStringType"/>
		<attribute name="filterAttributeId" type="fews:idStringType"/>
	</complexType>
</schema>
