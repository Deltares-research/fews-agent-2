<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:fews="http://www.wldelft.nl/fews/topology"
		targetNamespace="http://www.wldelft.nl/fews/topology" elementFormDefault="qualified"
		version="1.0">
	<element name="topologyEditorDisplay" type="fews:TopologyEditorDisplayComplexType"/>
	<complexType name="TopologyEditorDisplayComplexType">
		<sequence>
			<element name="overviewPanel" type="fews:OverviewPanelComplexType">
				<annotation>
					<documentation>This panel shows all the features and links in the network. It is possible to group the features by using feature groups.</documentation>
				</annotation>
			</element>
			<element name="actionPanel" type="fews:ActionPanelComplexType"/>
			<element name="mapEditorPanel" type="fews:MapEditorComplexType">
				<annotation>
					<documentation>Configuration options for the map panel in which the network can be drawn.</documentation>
				</annotation>
			</element>
			<element name="featureType" type="fews:FeatureTypeComplexType" maxOccurs="unbounded"/>
			<element name="featureEditor" type="fews:FeatureEditorComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>This element can be used to schedule archive tasks</documentation>
				</annotation>
			</element>
			<element name="customEditor" type="fews:CustomEditorComplexType" minOccurs="0"/>
			<element name="featureTypeGroup" type="fews:FeatureTypeGroupComplexType" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<complexType name="OverviewPanelComplexType">
		<sequence>
			<element name="featureTypeGroups" type="fews:FeatureTypeGroupsComplexType"/>
		</sequence>
	</complexType>
	<complexType name="FeatureTypeGroupsComplexType">
		<sequence>
			<element name="featureTypeGroupId" type="string" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<complexType name="PropertiesComplexType">
		<sequence>
			<element name="description" type="string" minOccurs="0">
				<annotation>
					<documentation>Optional description (this is never used in the code).</documentation>
				</annotation>
			</element>
			<choice maxOccurs="unbounded">
				<element name="string" type="fews:StringPropertyComplexType"/>
				<element name="double" type="fews:DoublePropertyComplexType"/>
				<element name="bool" type="fews:BoolPropertyComplexType"/>
			</choice>
		</sequence>
	</complexType>
	<complexType name="DoublePropertyComplexType">
		<attribute name="key" type="string" use="required"/>
		<attribute name="value" type="double" use="required"/>
	</complexType>
	<complexType name="BoolPropertyComplexType">
		<attribute name="key" type="string" use="required"/>
		<attribute name="value" type="boolean" use="required"/>
	</complexType>

	<complexType name="StringPropertyComplexType">
		<sequence>
			<element name="description" type="string" minOccurs="0">
				<annotation>
					<documentation>Optional description (this is never used in the code).</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="key" type="string" use="required"/>
		<attribute name="value" type="string" use="required"/>
	</complexType>

	<complexType name="MapEditorComplexType">
		<sequence>
			<element name="linkDisplayOptions" type="fews:LinkComplexType" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<complexType name="LinkComplexType">
		<sequence>
			<element name="linkId" type="string"/>
			<element name="color" type="fews:colorEnumStringType"/>
			<element name="lineStyle" type="string" minOccurs="0"/>
			<element name="lineThickness" type="integer" minOccurs="0"/>
		</sequence>
	</complexType>
