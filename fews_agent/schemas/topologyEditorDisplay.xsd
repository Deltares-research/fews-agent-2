	<complexType name="ActionPanelComplexType">
		<sequence>
			<element name="actionPanelTab" type="fews:ActionPanelTabComplexType" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<complexType name="ActionPanelTabComplexType">
		<sequence>
			<element name="featureTypeGroups" type="fews:FeatureTypeGroupsComplexType"/>
		</sequence>
		<attribute name="id" type="string" use="required"/>
		<attribute name="name" type="string" use="required"/>
	</complexType>
	<complexType name="FeatureTypeComplexType">
		<attribute name="id" type="string" use="required"/>
		<attribute name="name" type="string" use="required"/>
		<attribute name="type" type="fews:nodeTypeEnumStringType" use="required"/>
		<attribute name="hasProperties" type="boolean" default="true"/>
	</complexType>
	<complexType name="FeatureEditorComplexType">
		<sequence>
			<sequence>
				<element name="featureType" type="string">
					<annotation>
						<documentation>The type of the feature</documentation>
					</annotation>
				</element>
				<element name="propertyEditorTab" type="fews:PropertyTabComplexType" maxOccurs="unbounded">
					<annotation>
						<appinfo>The table editor (property groups en properties) can be configured with this option.</appinfo>
					</annotation>
				</element>
			</sequence>
		</sequence>
	</complexType>
	<complexType name="CustomEditorComplexType">
		<sequence>
			<element name="sourcePriorityEditor" type="fews:SourcePriorityPanelComplexType"/>
		</sequence>
	</complexType>
	<complexType name="PropertyTabComplexType">
		<sequence>
			<element name="propertyGroup" type="fews:PropertyGroupComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>Properties which belong to the same group will shown together in the display.</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="name" type="string">
			<annotation>
				<documentation>The properties will have an combined header with this configured name in the table.</documentation>
			</annotation>
		</attribute>
	</complexType>
	<complexType name="TablePropertyComplexType">
		<sequence>
