<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:fews="http://www.wldelft.nl/fews" targetNamespace="http://www.wldelft.nl/fews" elementFormDefault="qualified" attributeFormDefault="unqualified"
		version="1.0">
	<include schemaLocation="sharedTypes.xsd"/>
	<element name="annotationMetadataSchema" type="fews:AnnotationMetadataSchemaComplexType"/>
	<complexType name="AnnotationMetadataSchemaComplexType">
		<sequence>
			<element name="valueTypes" type="fews:AnnotationValueTypesComplexType"/>
			<element name="properties" type="fews:AnnotationPropertiesComplexType"/>
		</sequence>
	</complexType>
	<complexType name="AnnotationValueTypesComplexType">
		<choice maxOccurs="unbounded">
			<element name="enumerationsCsvFile" type="fews:AnnotationEnumerationsCsvFileComplexType">
				<annotation>
					<documentation>Reference to csv file than contains multiple annotation property enum definitions</documentation>
				</annotation>
			</element>
			<element name="enumeration" type="fews:AnnotationEnumerationComplexType">
				<annotation>
					<documentation>Enumeration definition</documentation>
				</annotation>
			</element>
			<element name="string" type="fews:AnnotationPropertyValueTypeComplexType">
				<annotation>
					<documentation>Text property definition</documentation>
				</annotation>
			</element>
		</choice>
	</complexType>
	<complexType name="AnnotationPropertiesComplexType">
		<choice maxOccurs="unbounded">
			<element name="propertiesCsvFile" type="fews:AnnotationPropertiesCsvFileComplexType">
				<annotation>
					<documentation>Reference to csv file than contains multiple property definitions</documentation>
				</annotation>
			</element>
			<element name="property" type="fews:AnnotationPropertyDefComplexType">
				<annotation>
					<documentation>Definition a property that is allowed in the Annotation meta data</documentation>
				</annotation>
			</element>
		</choice>
	</complexType>
	<complexType name="AnnotationPropertyValueTypeComplexType">
		<attribute name="id" type="string"/>
	</complexType>
	<complexType name="AnnotationEnumerationComplexType">
		<sequence>
			<element name="value" type="fews:AnnotationEnumerationValueComplexType" maxOccurs="unbounded"/>
		</sequence>
		<attribute name="id" type="string"/>
	</complexType>
	<complexType name="AnnotationEnumerationValueComplexType">
		<sequence>
			<element name="description" type="string"/>
		</sequence>
		<attribute name="code" type="fews:nonEmptyStringType" use="required"/>
		<attribute name="label" type="fews:nonEmptyStringType"/>
		<attribute name="constraintEnumerationId" type="fews:idStringType"/>
		<attribute name="constraintEnumerationCode" type="fews:nonEmptyStringType"/>
	</complexType>
	<complexType name="AnnotationEnumerationsCsvFileComplexType">
		<sequence>
			<element name="file" type="fews:nonEmptyStringType">
				<annotation>
					<documentation>name of a csv file in the map layer files or a full absolute path to the csv file(*.csv).</documentation>
				</annotation>
			</element>
			<element name="charset" type="fews:charsetEnumStringType" default="ISO-8859-1" minOccurs="0">
				<annotation>
					<documentation>Character set of the text in the csv file. Specify only when the csv file containsnon western characters.</documentation>
				</annotation>
			</element>
			<group ref="fews:AnnotationEnumerationsResourceSequence"/>
		</sequence>
	</complexType>
	<group name="AnnotationEnumerationsResourceSequence">
		<sequence>
			<element name="id" type="fews:nonEmptyStringType">
				<annotation>
					<documentation>id of enum value type id of the filed the csv file. e.g. "%TYPE%", put the actual column name between %%.</documentation>
				</annotation>
			</element>
			<element name="code" type="fews:idStringType">
				<annotation>
					<documentation>put the actual column name between %%</documentation>
				</annotation>
			</element>
			<element name="label" type="fews:idStringType">
				<annotation>
					<documentation>put the actual column name between %%</documentation>
				</annotation>
			</element>
			<element name="description" type="fews:idStringType">
				<annotation>
					<documentation>put the actual column name between %%</documentation>
				</annotation>
			</element>
			<element name="constraintEnumerationId" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>put the actual column name between %%</documentation>
				</annotation>
			</element>
			<element name="constraintEnumerationCode" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>put the actual column name between %%</documentation>
				</annotation>
			</element>
		</sequence>
	</group>
	<complexType name="AnnotationPropertiesCsvFileComplexType">
		<sequence>
			<element name="file" type="fews:nonEmptyStringType">
				<annotation>
					<documentation>name of a csv file in the map layer files or a full absolute path to the csv file (*.csv).</documentation>
				</annotation>
			</element>
			<element name="charset" type="fews:charsetEnumStringType" default="ISO-8859-1" minOccurs="0">
				<annotation>
					<documentation>Character set of the text in the csv file. Specify only when the csv file containsnon western characters.</documentation>
				</annotation>
			</element>
			<group ref="fews:AnnotationPropertiesResourceSequence"/>
		</sequence>
	</complexType>
	<group name="AnnotationPropertiesResourceSequence">
		<sequence>
			<element name="id" type="fews:nonEmptyStringType">
				<annotation>
					<documentation>id of the filed the csv file. e.g. "H_%ID%", put the actual column name between %%.</documentation>
				</annotation>
			</element>
			<element name="name" type="fews:nonEmptyStringType" minOccurs="0">
				<annotation>
					<documentation>Name displayed to user</documentation>
				</annotation>
			</element>
			<element name="description" type="fews:nonEmptyStringType" minOccurs="0">
				<annotation>
					<documentation>put the actual column name between %%</documentation>
				</annotation>
			</element>
			<element name="valueTypeId" type="fews:nonEmptyStringType" minOccurs="0">
				<annotation>
					<documentation>put the actual column name between %%</documentation>
				</annotation>
			</element>
		</sequence>
	</group>
	<complexType name="AnnotationPropertyDefComplexType">
		<sequence>
			<element name="description" type="fews:nonEmptyStringType" minOccurs="0">
				<annotation>
					<documentation>Description visible for the user in the Annotation table</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="id" type="fews:nonEmptyStringType" use="required">
			<annotation>
				<documentation>Id used to store the property value in the datastore, never change</documentation>
			</annotation>
		</attribute>
		<attribute name="name" type="fews:nonEmptyStringType">
			<annotation>
				<documentation>Name displayed to the user</documentation>
			</annotation>
		</attribute>
		<attribute name="valueTypeId" type="fews:nonEmptyStringType" use="required">
			<annotation>
				<documentation>Reference to the value type defined earlier in this xml file.</documentation>
			</annotation>
		</attribute>
	</complexType>
</schema>