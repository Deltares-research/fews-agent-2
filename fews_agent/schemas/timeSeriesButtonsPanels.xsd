<?xml version="1.0" encoding="UTF-8"?>
	<schema xmlns:fews="http://www.wldelft.nl/fews" xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.wldelft.nl/fews" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<include schemaLocation="sharedTypes.xsd"/>
	<element name="timeSeriesButtonsPanels" type="fews:TimeSeriesButtonsPanelsComplexType"/>
	<complexType name="TimeSeriesButtonsPanelsComplexType">
	<sequence>
			<element name="panel" type="fews:TimeSeriesButtonsPanelComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>
						  Panel that is referenced from the topology
					</documentation>
				</annotation>
			</element>
	</sequence>
</complexType>

<complexType name="TimeSeriesButtonsPanelComplexType">
	<sequence>
			<element name="resolveInWorkflow" type="boolean"/>
			<element name="resolveInPlots" type="boolean"/>
			<element name="button" type="fews:ButtonComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>
						Adds a button to the panel at the specified row column
					</documentation>
				</annotation>
			</element>
	</sequence>
		<attribute name="id" type="fews:idStringType" use="required">
				<annotation>
					<documentation>
						Id of the panel listed in the topology
								</documentation>
				</annotation>
	</attribute>
</complexType>
<complexType name="ButtonComplexType">
	<sequence>
		<element name="defaultForTopologyNodeIdPattern" type="string" minOccurs="0">
			<annotation>
				<documentation>Since 2014.03. For all topology nodes that matches this wildcard (*?) pattern this button is automatically selected</documentation>
			</annotation>
		</element>
		<element name="toolTip" type="string" minOccurs="0">
			<annotation>
				<documentation>
					Tooltip of the button
				</documentation>
			</annotation>
		</element>
		<group ref="fews:TimeSeriesFilterGroup">
			<annotation>
					<documentation>
						Filters the time series from the plots or from the workflow
					</documentation>
				</annotation>
		</group>
	</sequence>
	<attribute name="groupId" type="fews:nonEmptyStringType" use="required">
				<annotation>
					<documentation>
						Radio button group id. When a button is pressed all another buttons within the same group are unpressed. With ctrl click it is still possible to click multiple buttons within a group. eg. You can have a parameters and locations group. At least one button is every group is always pressed. When selecting multiple buttons within one group the selection becomes wider. Space is automatically added between buttons from different groups
								</documentation>
				</annotation>
	</attribute>
	<attribute name="name" type="fews:nonEmptyStringType" use="optional">
				<annotation>
					<documentation>
						Caption of the button
								</documentation>
				</annotation>
	</attribute>
	<attribute name="row" type="positiveInteger" use="required">
				<annotation>
					<documentation>
						Most top row is 1
					</documentation>
				</annotation>
	</attribute>
	<attribute name="column" type="positiveInteger" use="required">
	<annotation>
				<documentation>
					Most left column is 1;
				</documentation>
			</annotation>
	</attribute>
</complexType>
</schema>

