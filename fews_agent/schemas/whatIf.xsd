<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:fews="http://www.wldelft.nl/fews" targetNamespace="http://www.wldelft.nl/fews" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<include schemaLocation="sharedTypes.xsd"/>
	<element name="whatIf" type="fews:WhatIfComplexType">
		<annotation>
			<documentation>Stores  selections, values and references that has been entered in the whatIfTemplate</documentation>
		</annotation>
	</element>
	<complexType name="WhatIfComplexType">
		<sequence>
			<element name="id" type="fews:idStringType">
				<annotation>
					<documentation>Id of  the whatIf</documentation>
				</annotation>
			</element>
			<element name="name" type="fews:nameStringType" minOccurs="0">
				<annotation>
					<documentation>Optional name of the whatIf</documentation>
				</annotation>
			</element>
			<element name="description" type="string" minOccurs="0">
				<annotation>
					<documentation>Optional description of the whatIf</documentation>
				</annotation>
			</element>
			<element name="parentId" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>Id of  the parent whatIf</documentation>
				</annotation>
			</element>
			<element name="userId" type="fews:idStringType">
				<annotation>
					<documentation>Id of the user that has generated this whatIf</documentation>
				</annotation>
			</element>
			<element name="templateId" type="fews:idStringType">
				<annotation>
					<documentation>Id of the whatIfTemplate   that has been used to generate this whatIf</documentation>
				</annotation>
			</element>
			<element name="referencedTemplateId" type="fews:idStringType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Id of a referenced whatIfTemplate that has been used to generate this whatIf</documentation>
				</annotation>
			</element>
			<element name="properties" type="fews:PropertiesComplexType" minOccurs="0">
				<annotation>
					<documentation>Contains  selections , values and references  that has been entered in WhatIfTemplate specified with templateId</documentation>
				</annotation>
			</element>
			<element name="originalModifiers" type="fews:SelectedModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>References to the modifiers from which the modifiers in this what-if are copied</documentation>
				</annotation>
			</element>
			<element name="modifier" type="fews:SelectedModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>References to the modifiers that have  been selected in the  WhatIfTemplate specified with templateId</documentation>
				</annotation>
			</element>
			<element name="locationSet" type="fews:WhatIfLocationSetComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Location sets  that have  been created  in the  WhatIfTemplate specified with templateId</documentation>
				</annotation>
			</element>
			<element name="singleRunWhatIf" type="boolean" minOccurs="0">
				<annotation>
					<documentation>Since 2023.02. Only used by the WebOC! If set to true the what-if can only be applied once.</documentation>
				</annotation>
			</element>
			<element name="creationTime" type="fews:DateTimeComplexType" minOccurs="0">
				<annotation>
					<documentation>The creation time of this what-if. The creation time is used for the ifd icons.</documentation>
				</annotation>
			</element>

		</sequence>
	</complexType>
	<complexType name="SelectedModifierComplexType">
		<attribute name="modifierTypeId" type="fews:idStringType" use="required">
			<annotation>
				<documentation>Modifier type  Id as configurted in ModifierTypes.xml</documentation>
			</annotation>
		</attribute>
		<attribute name="modifierId" type="fews:idStringType" use="required">
			<annotation>
				<documentation>Id of the modifier   </documentation>
			</annotation>
		</attribute>
		<attribute name="systemActivityDescriptorId" type="fews:idStringType" use="required">
			<annotation>
				<documentation>Id of the system activity descriptor that has created the modifier</documentation>
			</annotation>
		</attribute>
	</complexType>
	<complexType name="WhatIfLocationComplexType">
		<sequence>
			<element name="x" type="double">
				<annotation>
					<documentation>Location X coordinate </documentation>
				</annotation>
			</element>
			<element name="y" type="double">
				<annotation>
					<documentation>Location  Y coordinate</documentation>
				</annotation>
			</element>
			<element name="z" type="double" minOccurs="0">
				<annotation>
					<documentation>Location Z coordinate</documentation>
				</annotation>
			</element>
			<element name="parentLocationId" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>Location Id of parent location</documentation>
				</annotation>
			</element>
			<group ref="fews:AttributesSequence" minOccurs="0"/>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required">
			<annotation>
				<documentation>Location Id</documentation>
			</annotation>
		</attribute>
		<attribute name="name" type="fews:nameStringType">
			<annotation>
				<documentation>Location name</documentation>
			</annotation>
		</attribute>
	</complexType>
	<complexType name="WhatIfLocationSetComplexType">
		<sequence>
			<element name="whatIfLocationSetId" type="fews:idStringType">
				<annotation>
					<documentation>whatIfLocationSetId   as configured in WhatIfTemplates.xml</documentation>
				</annotation>
			</element>
			<element name="geoDatum" type="fews:geoDatumStringType"/>
			<element name="location" type="fews:WhatIfLocationComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>List of locations that has been created for this whatIfLocationSetId </documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
</schema>
