# Azure OpenAI credentials used by compose.azure.yml.
#
# Copy to `.env.azure` (gitignored) and fill in the real values, then:
#
#     docker compose -f compose.azure.yml up --build
#
# In Azure these don't come from a file — they're set as Container App
# environment variables + secrets (see deploy notes in compose.azure.yml).

FEWS_AGENT_PROVIDER=AZURE

# Endpoint of the Azure OpenAI resource — copy from the Azure portal.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com

# Resource key (Key1 or Key2 from the portal).
AZURE_OPENAI_API_KEY=<paste-key-here>

# Name of the model deployment inside the resource — NOT the underlying
# model id. E.g. you might deploy `gpt-4o-mini` under the deployment
# name `chat-default`.
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# Optional: pin the REST API version. Defaults to 2024-10-21 in code.
# AZURE_OPENAI_API_VERSION=2024-10-21
