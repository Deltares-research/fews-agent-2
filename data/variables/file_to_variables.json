        {"path": "thresholdGroup[].defaultThreshold", "kind": "scalar", "required": false, "repeating_group": "thresholdGroup"},
        {"path": "thresholdGroup[].levelThreshold[].id", "kind": "id_declaration", "declares": "levelThresholdId", "required": true, "repeating_group": "thresholdGroup.levelThreshold"},
        {"path": "thresholdGroup[].levelThreshold[].name", "kind": "scalar", "required": false, "repeating_group": "thresholdGroup.levelThreshold"},
        {"path": "thresholdGroup[].levelThreshold[].shortName", "kind": "scalar", "required": false, "repeating_group": "thresholdGroup.levelThreshold"},
        {"path": "thresholdGroup[].levelThreshold[].upWarningLevelId", "kind": "reference", "ref": "warningLevelId", "required": true, "repeating_group": "thresholdGroup.levelThreshold"}
      ]
    },

    "ThresholdValueSets": {
