        {"path": "enableAutoRun", "kind": "flag", "required": false},
        {"path": "enableAutoSelectParameters", "kind": "flag", "required": false},
        {"path": "enableSelectNodesFromMap", "kind": "flag", "required": false},
        {"path": "node[].id", "kind": "id_declaration", "declares": "topologyNodeId", "required": true, "repeating_group": "node"},
        {"path": "node[].name", "kind": "scalar", "required": true, "repeating_group": "node"},
        {"path": "node[].url", "kind": "scalar", "required": false, "repeating_group": "node"},
        {"path": "node[].workflowId", "kind": "reference", "ref": "workflowId", "required": false, "repeating_group": "node"},
