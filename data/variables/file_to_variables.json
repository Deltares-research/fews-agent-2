        {"path": "qualifier[].name", "kind": "scalar", "required": false, "repeating_group": "qualifier"},
        {"path": "qualifier[].group", "kind": "scalar", "required": false, "repeating_group": "qualifier"},
        {"path": "qualifier[].shortName", "kind": "scalar", "required": false, "repeating_group": "qualifier"}
      ]
    },

    "Topology": {
