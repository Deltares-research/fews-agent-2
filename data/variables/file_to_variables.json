{
  "_meta": {
    "description": "Per-file-type flat checklist of variables the LLM must elicit before generation. Derived from data/input_parameters.json.",
    "purpose": "Forward index: given a target file type, list every variable a user must supply (or skip if optional).",
    "kinds": {
      "scalar": "plain string/number value",
      "enum": "one of a fixed set (see allowed_values when known)",
      "reference": "cross-file ID reference; semantic validator must resolve",
      "id_declaration": "declares a new ID (locationId, parameterId, moduleInstanceId, ...)",
      "compound": "structured sub-object; expand per 'shape' or reuse shared substructure",
      "flag": "presence/absence boolean (XML element, not attribute)",
      "static": "template-constant (version, xmlns); not elicited from user",
      "fews_template": "FEWS runtime substitution (%...%, $VAR$, @pat@); pass through verbatim"
    },
    "path_conventions": {
      "[]": "appears inside a repeating list; per-item value",
      ".": "nested structure",
      "A|B": "user supplies exactly one of A or B"
    },
    "shared_substructures": {
      "timeSeriesSet": ["moduleInstanceId", "valueType", "parameterId", "locationId|locationSetId", "timeSeriesType", "timeStep", "readWriteMode", "synchLevel?", "expiryTime?", "ensembleId?", "relativeViewPeriod?"],
      "timeStep": ["unit", "multiplier", "or id"],
      "relativeViewPeriod": ["unit", "start", "end"],
      "extremeValues": ["hardMax", "hardMin", "softMax?", "softMin?"]
    }
  },

  "file_types": {

    "IdMapFile": {
      "variables": [
        {"path": "version", "kind": "static", "required": true},
        {"path": "parameter[].internal", "kind": "reference", "ref": "parameterId", "required": true, "repeating_group": "parameter"},
        {"path": "parameter[].external", "kind": "scalar", "required": true, "repeating_group": "parameter"},
        {"path": "parameter[].internalQualifier", "kind": "reference", "ref": "qualifierId", "required": false, "repeating_group": "parameter"},
        {"path": "parameter[].externalQualifier", "kind": "scalar", "required": false, "repeating_group": "parameter"},
        {"path": "location[].internal", "kind": "reference", "ref": "locationId", "required": true, "repeating_group": "location"},
        {"path": "location[].external", "kind": "scalar", "required": true, "repeating_group": "location"},
        {"path": "function[].internalLocationSet", "kind": "reference", "ref": "locationSetId", "required": true, "repeating_group": "function"},
        {"path": "function[].externalLocationFunction", "kind": "fews_template", "required": true, "repeating_group": "function", "note": "pattern with @tokens@"},
        {"path": "function[].externalParameterFunction", "kind": "fews_template", "required": true, "repeating_group": "function"},
        {"path": "function[].internalParameter", "kind": "reference", "ref": "parameterId", "required": true, "repeating_group": "function"},
        {"path": "map[].internalParameter", "kind": "reference", "ref": "parameterId", "required": true, "repeating_group": "map"},
        {"path": "map[].internalLocation", "kind": "reference", "ref": "locationId", "required": true, "repeating_group": "map"},
        {"path": "map[].externalParameter", "kind": "scalar", "required": true, "repeating_group": "map"},
        {"path": "map[].externalLocation", "kind": "scalar", "required": true, "repeating_group": "map"},
        {"path": "enableOneToOneMapping", "kind": "flag", "required": false}
      ]
    },

    "Locations": {
      "variables": [
        {"path": "version", "kind": "static", "required": true},
        {"path": "geoDatum", "kind": "enum", "required": true, "allowed_values": ["WGS 1984", "other FEWS-supported datums"]},
        {"path": "location[].id", "kind": "id_declaration", "declares": "locationId", "required": true, "repeating_group": "location"},
        {"path": "location[].name", "kind": "scalar", "required": true, "repeating_group": "location"},
        {"path": "location[].x", "kind": "scalar", "required": true, "repeating_group": "location", "note": "longitude or projected x"},
        {"path": "location[].y", "kind": "scalar", "required": true, "repeating_group": "location"},
        {"path": "location[].shortName", "kind": "scalar", "required": false, "repeating_group": "location"},
        {"path": "location[].description", "kind": "scalar", "required": false, "repeating_group": "location"},
        {"path": "location[].z", "kind": "scalar", "required": false, "repeating_group": "location"},
        {"path": "location[].parentLocationId", "kind": "reference", "ref": "locationId", "required": false, "repeating_group": "location"},
        {"path": "location[].relation", "kind": "scalar", "required": false, "repeating_group": "location"},
        {"path": "location[].attribute[]", "kind": "compound", "required": false, "repeating_group": "location", "shape": {"key": "scalar", "value": "scalar"}}
      ]
    },

    "Parameters": {
      "variables": [
        {"path": "version", "kind": "static", "required": true},
        {"path": "parameterGroup[].id", "kind": "id_declaration", "declares": "parameterGroupId", "required": true, "repeating_group": "parameterGroup"},
        {"path": "parameterGroup[].name", "kind": "scalar", "required": false, "repeating_group": "parameterGroup"},
        {"path": "parameterGroup[].parameterType", "kind": "enum", "required": true, "repeating_group": "parameterGroup", "allowed_values": ["instantaneous", "accumulative", "mean"]},
        {"path": "parameterGroup[].unit", "kind": "scalar", "required": true, "repeating_group": "parameterGroup"},
        {"path": "parameterGroup[].valueResolution", "kind": "scalar", "required": false, "repeating_group": "parameterGroup"},
        {"path": "parameterGroup[].usesDatum", "kind": "flag", "required": false, "repeating_group": "parameterGroup"},
        {"path": "parameterGroup[].parameter[].id", "kind": "id_declaration", "declares": "parameterId", "required": true, "repeating_group": "parameterGroup.parameter"},
        {"path": "parameterGroup[].parameter[].name", "kind": "scalar", "required": false, "repeating_group": "parameterGroup.parameter"},
        {"path": "parameterGroup[].parameter[].shortName", "kind": "scalar", "required": false, "repeating_group": "parameterGroup.parameter"},
        {"path": "parameterGroup[].parameter[].description", "kind": "scalar", "required": false, "repeating_group": "parameterGroup.parameter"},
        {"path": "parameterGroup[].parameter[].standardUnit", "kind": "scalar", "required": false, "repeating_group": "parameterGroup.parameter"}
      ]
    },

    "Qualifiers": {
      "variables": [
        {"path": "allowReferencingUndefinedQualifiers", "kind": "flag", "required": false},
