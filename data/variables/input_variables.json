      "file_level_id_source": "filename maps to workflow.id (referenced by Topology and other workflows)",
      "required": {
        "version": "e.g. '1.1'",
        "activities": {
          "tag": "activity (repeating; at least one)",
          "item": {
            "runIndependent": "bool",
            "moduleInstanceId": "reference; OR",
            "workflowId": "reference for nested workflow; OR",
            "moduleConfigFileName": "optional override for template-based instances",
            "properties": "optional local key-value overrides passed to the module"
          }
        }
      },
      "optional": {
        "properties": {
          "tag": "properties -> string (key/value)",
          "purpose": "substitution values consumed by $PLACEHOLDER$ tokens in module config templates",
          "common_keys": ["FORECAST", "STARTTIME", "ENDTIME", "PARAMETER1", "PARAMETER2", "TIMESTEP", "ENSEMBLE", "TIMESERIESTYPE", "STATIONLOCATIONS", "INPUTMODULEINSTANCEMETEO", "MODELNAME", "MODELNAME2"]
        }
      },
      "references": ["moduleInstanceId -> ModuleConfigFile (by filename)", "workflowId -> Workflow (by filename)"]
    },

    "MapLayers": {
      "root_element": "various (no FEWS-authored XML found in tutorial)",
      "subdir": "MapLayerFiles/",
      "notes": "Tutorial only contains ArcGIS/GDAL sidecar XML (*.shp.xml, *.map.aux.xml), not FEWS map layer configs. Skipped. If/when a true FEWS mapLayers config is needed, inspect a real example before adding an entry here."
    }

  },

  "cross_cutting_concerns": {
    "fews_runtime_substitutions": {
      "note": "These tokens are resolved by FEWS at runtime, not by Jinja at render time. Generators must emit them verbatim.",
      "forms": [
        "%TIME_ZERO(yyyyMMdd)%, %TIME_ZERO(HH)%  -- forecast time formatting",
        "$PROPERTY_NAME$  -- workflow property substitution",
        "@pattern@  -- IdMap function pattern (e.g. @SubBasin@)",
        "%PARAMETER_NAME%  -- display legend substitution"
      ]
    },
    "cross_file_id_graph": {
      "note": "Semantic validator must build an ID registry across all generated files and resolve references.",
      "declared_ids": {
        "locationId": "Locations.xml (location.id)",
        "locationSetId": "LocationSets.xml (not in this tutorial survey; RegionConfigFiles/LocationSets.xml in full configs)",
        "parameterId": "Parameters.xml (parameter.id)",
        "qualifierId": "Qualifiers.xml (qualifier.id)",
        "moduleInstanceId": "filename of ModuleConfigFiles/**/*.xml (by convention; also declared in ModuleInstanceDescriptors)",
        "workflowId": "filename of WorkflowFiles/**/*.xml",
        "idMapId": "filename of IdMapFiles/**/*.xml",
        "unitConversionsId": "filename of UnitConversionsFiles/*.xml",
        "warningLevelId": "ThresholdWarningLevels.xml",
        "modifierId": "ModifierTypes.xml"
      }
    },
    "shared_substructures": {
      "timeSeriesSet": {
        "used_in": ["ImportModule", "PreprocessModule", "DataProcessingModule", "ValidationRuleSets", "ThresholdValueSets", "ModifierTypes"],
        "fields": ["moduleInstanceId", "valueType", "parameterId", "locationId|locationSetId", "timeSeriesType", "timeStep", "readWriteMode", "synchLevel?", "expiryTime?", "ensembleId?", "relativeViewPeriod?"]
      },
      "timeStep": {"unit": "'second'|'minute'|'hour'|'day'|'week'|'month'|'year'|'nonequidistant'", "multiplier": "int", "or_id": "reference to a named timeStep"},
      "relativeViewPeriod": {"unit": "string", "start": "int", "end": "int"},
      "externUnit": {"parameterId": "ref", "unit": "str", "cumulativeSum": "bool?"}
    }
  },

  "not_surveyed_in_tutorial": [
    "LocationSets (typically RegionConfigFiles/LocationSets.xml) — present in full configs, absent here",
    "Grids (RegionConfigFiles/Grids.xml)",
    "Filters (RegionConfigFiles/Filters.xml)",
    "Products / ReportTemplates",
    "ModuleInstanceDescriptors (RegionConfigFiles/ModuleInstanceDescriptors.xml)",
    "WorkflowDescriptors (RegionConfigFiles/WorkflowDescriptors.xml)",
    "RollingBarrel, SystemMonitor, ScheduledTasks (SystemConfigFiles)"
  ]
}
