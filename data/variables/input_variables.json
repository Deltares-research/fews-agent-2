      "required": {
        "imports": {
          "tag": "import (repeating; at least one)",
          "item": {
            "general": {
              "importType": "enum: NETCDF-CF_GRID | grib2 | CanadaMeteo | CanadaMeteoWCS | ... (source-specific)",
              "serverUrl_or_folder": "endpoint URL or local folder; may contain %TIME_ZERO(fmt)% / $VAR$ substitutions",
              "idMapId": "reference to IdMapFile (by filename)",
              "unitConversionsId": "reference to UnitConversions (optional)",
              "missingValue": "numeric sentinel (optional)",
              "importTimeZone": "{timeZoneName: 'GMT'|'PST'|...} (optional)",
              "dataFeedId": "friendly id for logging (optional)",
              "relativeViewPeriod": "{unit, start, end} (optional; often $STARTTIME$/$ENDTIME$)"
            },
            "startTimeShift": {
              "_optional": true,
              "parameterId": "reference",
              "relativePeriod": "{unit, start, end}"
            },
            "properties": "optional list of <string key=.. value=../> for source-specific options (auth, region, subsetting)",
            "timeSeriesSets": {
              "tag": "timeSeriesSet (repeating)",
              "item": {
                "moduleInstanceId": "this module's id (must match filename)",
                "valueType": "'grid' | 'scalar'",
                "parameterId": "FEWS parameterId (reference)",
                "locationId_or_locationSetId": "reference",
                "timeSeriesType": "'external historical' | 'external forecasting' | ...",
                "timeStep": "{unit, multiplier} or {id}",
                "readWriteMode": "'add originals' | 'overwrite existing values' | ...",
                "synchLevel": "int, optional",
                "expiryTime": "{unit, multiplier}, optional",
                "ensembleId": "optional, for ensemble imports"
              }
            },
            "externUnits": {
              "tag": "externUnit (repeating; one per imported parameter)",
              "item": {
                "parameterId": "reference",
                "unit": "source unit string",
                "cumulativeSum": "bool, optional"
              }
            },
            "fileNamePatternFilter": "for file-based imports (grib2, netcdf folder); wildcards ok; optional"
          }
        }
      },
      "references": ["idMapId", "unitConversionsId", "parameterId", "locationId", "locationSetId", "moduleInstanceId"],
      "variants_by_subdir": {
        "NOAA": "GFS, NAM, SREF — DODS URLs, NETCDF-CF_GRID",
        "ECCCGrids": "GDPS, RDPS, HRDPS, HRDPA, RDPA, REPS — CanadaMeteoWCS or WCS",
        "ECCCScalar": "WSC daily/hourly/historic — CanadaMeteo, often properties for RegionDirectory/TimeDirectory",
        "Earth2Observe": "E2O — NETCDF-CF_GRID, multi-import (tair, PET, precip, snow)",
        "EarthObservation": "GPM, GSMAP — NETCDF-CF_GRID from remote THREDDS",
        "Snow": "SNODAS, GLOBSNOW — grib2 or netcdf from local folder; fileNamePatternFilter per parameter"
      }
