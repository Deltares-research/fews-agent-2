      ],
      "file_level_id_source": "filename (no id attribute on root)",
      "required": {
        "version": "e.g. '1.1' (pin to schema version)"
      },
      "repeating": {
        "parameterMappings": {
          "tag": "parameter",
          "item": {
            "internal": "FEWS parameterId",
            "external": "source-system parameter name",
            "internalQualifier": "optional, e.g. 'min'|'max'|'mean'",
            "externalQualifier": "optional"
          }
        },
        "locationMappings": {
          "tag": "location",
          "item": {
            "internal": "FEWS locationId",
            "external": "source-system location/station id"
          }
        },
        "functionMappings": {
          "tag": "function",
          "purpose": "template-style mapping for model outputs (Raven, wflow)",
          "item": {
            "internalLocationSet": "references a LocationSet",
            "externalLocationFunction": "pattern like '@SubBasin@'",
            "externalParameterFunction": "pattern",
            "internalParameter": "FEWS parameterId"
          }
        },
        "mapMappings": {
          "tag": "map",
          "purpose": "grid-to-grid mapping (SNODAS, E2O)",
          "item": {
            "internalParameter": "FEWS parameterId",
            "internalLocation": "FEWS locationId",
            "externalParameter": "source parameter",
            "externalLocation": "source grid location"
          }
        }
      },
      "optional": {
        "enableOneToOneMapping": "flag element; present/absent"
      },
      "references": ["parameterId", "locationId", "locationSetId"],
      "notes": "Direction (import vs export) is by filename convention (IdImport*/IdExport*). Same XML shape either way."
