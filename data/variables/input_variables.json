{
  "_meta": {
    "description": "Per-FEWS-file-type input parameters required to generate an instance via templating. Surveyed from examples/config-tutorial/.",
    "source_tutorial": "examples/config-tutorial/",
    "generated": "2026-04-20",
    "conventions": {
      "required": "parameters a user must supply for the template to emit a valid instance",
      "optional": "parameters that have FEWS defaults or are instance-specific but not mandatory",
      "references": "fields whose values are IDs defined in another FEWS config file; semantic validator must resolve these",
      "repeating": "structured lists; per-item shape is given under 'item'",
      "fews_substitutions": "%TIME_ZERO(fmt)%, $STARTTIME$, $PROPERTY$, @pattern@ etc. are resolved by FEWS at runtime, not by our template engine. Treat as opaque strings.",
      "excluded_from_survey": [
        "ModuleDataSetFiles/wflowBinaries/** (gdal/wflow internals)",
        "**/gdal-data/*.xml, **/Library/share/gdal/*.xml",
        "*.shp.xml, *.map.aux.xml (ArcGIS/GDAL sidecars)",
        "ColdStateFiles/** (.rvc/.rvh/.rvp/.map; not XML configs)",
        "IconFiles/**, RootConfigFiles/** (binaries/properties)"
      ]
    }
  },

