# FEWS agent configuration.
# Copy to `secrets/.env` and edit. The TUI loads it via python-dotenv.

# Provider: ollama | anthropic   (openai / gemini not wired in slice 1)
FEWS_AGENT_PROVIDER=ollama

# Model id for the chosen provider.
# Ollama defaults to qwen2.5:7b-instruct (strong tool calling, ~8GB RAM).
# Set FEWS_AGENT_MODEL=phi3.5 to run the fast local path via the
# structured-output fallback (single-shot JSON, no tool-call loop).
FEWS_AGENT_MODEL=qwen2.5:7b-instruct

# API keys (only needed for the matching provider).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Ollama host. Leave unset to use the default (127.0.0.1:11434).
# OLLAMA_HOST=http://localhost:11434

# Where projects are stored. Defaults to ~/.fews-agent/.
# FEWS_AGENT_HOME=

# Unlock all 119 generator specs (default slice 1 exposes only 'locations').
# FEWS_AGENT_ALL_SPECS=1
