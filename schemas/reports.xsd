	<!-- Declarations for HTML Report Table (Row) Complex Type-->
	<complexType name="ReportHtmlTableFormatComplexType">
		<sequence>
			<element name="column" type="fews:tableAxisEnumStringType"/>
			<element name="row" type="fews:tableAxisEnumStringType"/>
			<element name="includeBeforeOrEqualToTimeZeroInChoiceFormat" type="boolean" minOccurs="0"/>
			<choice minOccurs="0">
				<annotation>
					<documentation>Customize view period</documentation>
				</annotation>
				<element name="relativeWholePeriod" type="fews:RelativePeriodComplexType">
					<annotation>
						<documentation>Use relativeWholePeriod to specify table view period that overrules the relative view period as specified  with TimeSerieSets and rounds the table view period to whole days</documentation>
					</annotation>
				</element>
				<element name="season" type="fews:SeasonConditionComplexType">
					<annotation>
						<documentation>Since 2015.02 Use season to specify table view period that overrules the relative view period as specified  with TimeSerieSets</documentation>
					</annotation>
				</element>
			</choice>
			<element name="trimViewPeriodToLastNonMissingAfterTime0" type="boolean" default="false" minOccurs="0">
				<annotation>
					<documentation>Since 2015.02 If True  then the time series view period  will be first trimmed to the last non missing value after time0,  and then the time series will be written to the report. </documentation>
				</annotation>
			</element>
			<element name="topLeftText" type="string" minOccurs="0"/>
			<element name="cellFormat" type="string"/>
			<element name="topFormat" type="string">
				<annotation>
					<documentation>Format of the column headers: "0,number,0.00" for a number, "0,date,dd/MMM" for a date. In combination with <column>location</column>, the topFormat specifies what should be written in the header of the column: "1" for location name, "2" for parameter name, "3" for parameter unit (N.B. use curly brackets in place of the quotation marks). In combination with <column>parameters</column> or <column>allSeries</column>, the topFormat element can be used to specify a custom column header for each data column. For a table with one data column just specify the custom column header in the topFormat element. For a table with multiple data columns, specify multiple custom column headers (one for each column), separated by "#" symbols, in the topFormat element. E.g. "header1#header2#header3". To use default headers instead of custom column headers, leave the topFormat element completely empty. If custom column headers are used, then there should be as many custom column headers as data columns in the table, otherwise a warning is logged and default column headers are used instead.</documentation>
				</annotation>
			</element>
			<element name="leftFormat" type="string"/>
			<element name="missingValueText" type="fews:missingValueEnumStringType" minOccurs="0"/>
			<element name="nullValueText" type="fews:nullValueEnumStringType" minOccurs="0"/>
			<element name="timesInDescendingOrder" type="boolean" default="false" minOccurs="0">
				<annotation>
					<documentation>Sinds 2015.02  Use this element to write the times in descending order . By default the times are written in ascending order.</documentation>
				</annotation>
			</element>
			<element name="scrollableTable" type="boolean" default="false" minOccurs="0">
				<annotation>
					<documentation>Use this to split the table into two parts, one for the header row(s) and one for the data rows. The data row part refers to the tableStyle for this table with "_scrollable" appended. This can be used to make the data rows scrollable while the header row(s) remain fixed. For this to work the referred style needs to be defined in the report tables .css file.</documentation>
				</annotation>
			</element>
			<element name="tableBackgroundColors" type="fews:TableBackgroundColorsComplexType" minOccurs="0">
				<annotation>
					<documentation>Since 2014.02. FEWS-10066. Override background colors for certain hours in the week</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="tableStyle" type="fews:tableStyleEnumStringType" use="required"/>
	</complexType>
