	<complexType name="ThresholdCrossingXmlExceedanceComplexType">
		<sequence>
			<element name="numberFormatId" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>If configured this number format is used to format the exceedance.</documentation>
				</annotation>
			</element>
			<element name="minEnsembleMembers" type="fews:positiveIntegerStringType">
				<annotation>
					<documentation>The minimum number of ensemble members that should cross a threshold for the earliest exceedance times to be calculated.</documentation>
				</annotation>
			</element>
			<element name="belowMinimumLabel" type="string" minOccurs="0">
				<annotation>
					<documentation>If at least one ensemble member but less than the minimum number of ensemble members cross a threshold, this text will be reported as the "exceedance" instead of the percentage of ensemble members that crossed the threshold.</documentation>
				</annotation>
			</element>
			<element name="earliestExceedanceTimeStep" type="fews:TimeStepComplexType" minOccurs="0">
				<annotation>
					<documentation>When configured the reported earliest exceedance times will be the closest time to the calculated earliest exceedance time within this time step.</documentation>
				</annotation>
			</element>
			<element name="scenarios" type="fews:ThresholdCrossingXmlScenariosComplexType">
				<annotation>
					<documentation>The scenarios for which the earliest exceedance times should be reported.</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="ThresholdCrossingXmlScenariosComplexType">
		<sequence>
			<element name="earliest" type="fews:NamedEmptyElement" minOccurs="0">
				<annotation>
					<documentation>When this element is included in the configuration (the element's body should be empty), the earliest exceedance time of the first ensemble member that exceeds the threshold will be included in the report.</documentation>
				</annotation>
			</element>
			<element name="percentile" type="fews:ThresholdCrossingXmlPercentileScenarioComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>A percentile for which a scenario should be included in the earliest exceedance time section of the report. To determine the earliest exceedance time for a percentile scenario, the earliest time at which each ensemble member exceeds the threshold is determined. Of those ensemble members that cross the threshold, the earliest exceedance times are ordered from earliest to latest. Then the x-th percentile of these times is determined. So for example, if this element is set to 25, the earliest time at which 25% of the ensemble members that cross the threshold at some point, have crossed the threshold is reported</documentation>
				</annotation>
			</element>
			<element name="latest" type="fews:NamedEmptyElement" minOccurs="0">
				<annotation>
					<documentation>When this element is included in the configuration (the element's body should be empty), the earliest exceedance time of the last ensemble member that exceeds the threshold will be included in the report.</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
