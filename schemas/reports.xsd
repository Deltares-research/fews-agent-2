						<annotation>
							<documentation>Id of the dateFormat or numberFormat that is declared in the  declarations section</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="RepeatingFunctionColumnGroupComplexType">
		<sequence>
			<element name="referenceTimesVariableId" type="fews:idStringType">
				<annotation>
					<documentation>Id that refers to a variable with reference times, that is defined as inputVariable for the report. This group of columns is repeated for each time that is present in this referenceTimesVariable.</documentation>
				</annotation>
			</element>
			<element name="relativeTimeWindow" type="fews:RelativePeriodComplexType">
				<annotation>
					<documentation>Time window that is used for each row to find data that corresponds to a given time in the referenceTimesVariable. This can e.g. be used when the times for different rows (i.e. locations) are not exactly the same. For a given repeat the corresponding time from the referenceTimesVariable and this relativeTimeWindow are combined to create a timeWindow for that repeat. A given repeat only uses data within its timeWindow for evaluating the functions that are configured in the columns.</documentation>
				</annotation>
			</element>
			<element name="includeRowForReferenceLocation" type="boolean" default="false">
				<annotation>
					<documentation>If this is true, then the location of the configured referenceTimesVariable is included as a row in the table. If this is false, then there will be no row for the location of the configured referenceTimesVariable in the table. Default is false.</documentation>
				</annotation>
			</element>
			<element name="column" type="fews:FunctionColumnComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>A group of one or more columns. This group is repeated as a whole for each time in the specified referenceTimesVariableId.</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="SchematicStatusDisplayPanelReportComplexType">
		<sequence>
			<element name="variable" type="fews:ScadaVariableDefinitionComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Definitions of variables that can be used as input and/or output for the components in this scada panel report or for the on-the-fly transformations that can be defined below. A variable is always a time series. Alternatively variable definitions can be embedded in the configuration below.</documentation>
				</annotation>
			</element>
			<element name="transformation" type="fews:TransformationFunctionComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>One or more transformations that will be carried out on-the-fly when the an output image is created. The results will not to be stored permanently in the local datastore.</documentation>
				</annotation>
			</element>
			<choice>
				<element name="scadaPanel" type="fews:ScadaPanelComplexType">
					<annotation>
						<documentation>The definition of a single scada panel as in the Schematic Status Display.  Note that the interactive sections such as Left Single Click Action and Left Double Click Action that can be configured in the Schematic Status Display are not supported within the reports.</documentation>
					</annotation>
				</element>
				<element name="scadaPanelId" type="fews:idStringType">
					<annotation>
						<documentation>Since 2017.02  Id of a scadaPanel that is configured in the Schematic Status Display.  Note that the interactive sections such as Left Single Click Action and Left Double Click Action that can be configured in the Schematic Status Display are not supported within the reports.</documentation>
					</annotation>
				</element>
			</choice>
			<element name="width" type="positiveInteger">
				<annotation>
					<documentation>Width of the output in pixels</documentation>
				</annotation>
			</element>
			<element name="height" type="positiveInteger">
				<annotation>
					<documentation>Height of the output in pixels</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="SchematicStatusDisplayPanelAnimationComplexType">
		<complexContent>
			<extension base="fews:SchematicStatusDisplayPanelReportComplexType">
				<sequence>
					<element name="relativePeriod" type="fews:RelativePeriodComplexType">
						<annotation>
							<documentation>This is the period to display in the output. This period is always relative to the current system time.</documentation>
						</annotation>
					</element>
					<element name="timeStep" type="fews:TimeStepComplexType">
						<annotation>
							<documentation>This is the timestep between the subsequent frames to be generated. </documentation>
						</annotation>
					</element>
					<element name="movieFrameDurationMillis" type="fews:positiveInteger" default="200" minOccurs="0">
						<annotation>
							<documentation>The duration of a frame when the avi is played. This is the number of milliseconds a frame/time step is visible before the next time step becomes visible. If not specified, then 200 milliseconds is used by default.</documentation>
						</annotation>
					</element>
					<element name="fileName" type="fews:fileStringType" minOccurs="0">
						<annotation>
							<documentation>The file name under which the avi-file is stored on the file system can be optionally configured. When omitted a file name is generated.</documentation>
						</annotation>
					</element>
				</sequence>
				<attribute name="id" type="fews:idStringType" use="required"/>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="SchematicStatusDisplayPanelSnapshotsComplexType">
		<complexContent>
			<extension base="fews:SchematicStatusDisplayPanelReportComplexType">
				<sequence>
					<element name="snapshot" type="fews:SchematicStatusDisplayPanelSnapshotComplexType" maxOccurs="unbounded">
						<annotation>
							<documentation>A series of snapshots to generate of the provided schematic status display panel.</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="SchematicStatusDisplayPanelSnapshotComplexType">
		<sequence>
			<element name="relativeTime" type="fews:RelativeTimeComplexType" minOccurs="0">
				<annotation>
					<documentation>Time of the plot relative of time0 of the report run, when no times are specified the first time in the time series is used</documentation>
				</annotation>
			</element>
			<element name="fileName" type="fews:fileStringType" minOccurs="0">
				<annotation>
					<documentation>The file name under which the spatial snapshot (image) is stored on the file system can be optionally configured. When omitted a file name is generated.</documentation>
				</annotation>
			</element>
			<element name="fileNamePrefix" type="fews:PrefixComplexType" minOccurs="0">
				<annotation>
