	<complexType name="RowPerLocationHtmlTableComplexType">
		<sequence>
			<choice minOccurs="0">
				<element name="omitRowsWithOnlyMissingValues" type="boolean" default="false">
					<annotation>
						<documentation>Since 2016.02  If  true then the rows with only missings are not written to the table. If  false, then always all rows are written. Default is false.</documentation>
					</annotation>
				</element>
				<element name="onlyWriteRowsWithCrossedThresholds" type="boolean" default="true">
					<annotation>
						<documentation>Since 2015.01. Optional. This is only used if one or more columns have a THRESHOLDCROSSING function configured. If this is true, then rows (i.e. locations) for which there are no thresholds crossed are not written in the table. If this is false, then all rows (i.e. locations) are written in the table. Default is true.</documentation>
					</annotation>
				</element>
			</choice>
			<element name="addUnfilledRowToEmptyTable" type="boolean" default="false" minOccurs="0">
				<annotation>
					<documentation>Since 2024.01. If set to true and the generated table  is completely empty (i.e. only a header is there),  add  an unfilled (clear) row to the table, so that the table has at least one row</documentation>
				</annotation>
			</element>
			<element name="writeSingleTable" type="fews:WriteSingleTableComplexType" minOccurs="0">
				<annotation>
					<documentation>Sinds 2015.02  Optional. If  configured,  a separate table will be generated for each timestep in the configured view period or season</documentation>
				</annotation>
			</element>
			<element name="season" type="fews:SeasonConditionComplexType" minOccurs="0">
				<annotation>
					<documentation>Since 2015.02 Use season to specify table view period that overrules the relative view period as specified  with TimeSerieSets</documentation>
				</annotation>
			</element>
			<choice>
				<element name="column" type="fews:FunctionColumnComplexType" maxOccurs="unbounded"/>
				<element name="htmlColumn" type="fews:HtmlColumnComplexType" maxOccurs="unbounded">
					<annotation>
						<documentation>Since 2024.01</documentation>
					</annotation>
				</element>
			</choice>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="tableStyle" type="fews:tableStyleEnumStringType" use="optional"/>
		<attribute name="tableClass" type="string" use="optional">
			<annotation>
				<documentation>Since 2023.01</documentation>
			</annotation>
		</attribute>
	</complexType>
	<complexType name="RowPerLocationCsvTableComplexType">
		<sequence>
			<choice minOccurs="0">
				<element name="omitRowsWithOnlyMissingValues" type="boolean" default="false">
					<annotation>
						<documentation>Since 2016.02  If  true then the rows with only missings are not written to the table. If  false, then always all rows are written. Default is false.</documentation>
					</annotation>
				</element>
				<element name="onlyWriteRowsWithCrossedThresholds" type="boolean" default="true">
					<annotation>
						<documentation>Since 2015.01. Optional. This is only used if one or more columns have a THRESHOLDCROSSING function configured. If this is true, then rows (i.e. locations) for which there are no thresholds crossed are not written in the table. If this is false, then all rows (i.e. locations) are written in the table. Default is true.</documentation>
					</annotation>
				</element>
			</choice>
			<choice maxOccurs="unbounded">
				<element name="column" type="fews:FunctionColumnComplexType">
					<annotation>
						<documentation>A single column.</documentation>
					</annotation>
				</element>
				<element name="repeatingColumnGroup" type="fews:RepeatingFunctionColumnGroupComplexType">
					<annotation>
						<documentation>A group of columns that is repeated for each time in the specified referenceTimesVariable. For a given repeat the corresponding time from the referenceTimesVariable and the configured relativeTimeWindow are combined to create a timeWindow for that repeat. A given repeat only uses data within its timeWindow for evaluating the functions that are configured in the columns. This can be used e.g. to create a maxValue and a minValue column that are repeated each day for four days. Then each repeat will write the minimum value and the maximum value of the data within a given day.</documentation>
					</annotation>
				</element>
			</choice>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
	</complexType>
