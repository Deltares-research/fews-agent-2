	<!-- Declarations for Report Query Complex Type-->
	<complexType name="TableTimeSeriesComplexType">
		<simpleContent>
			<extension base="fews:idStringType">
				<attribute name="mapId" type="string" use="optional">
					<annotation>
						<documentation>If mapId not specified, then information from the thresholdWarningLevels config file is used instead of a valueAttributeMap.</documentation>
					</annotation>
				</attribute>
				<attribute name="useThresholds" type="boolean" use="optional">
					<annotation>
						<documentation>Optional flag to indicate if thresholds should be used for this timeSeries. If true, then threshold crossings are determined and used to display warningLevels. If false, then thresholds are ignored and the timesSeries data values are displayed. If this flag is not specified, then the thresholds are only used if a mapId is specified and a thresholdValueSet is defined for this timeSeries. This flag is only used in elements table and htmlTable.</documentation>
					</annotation>
				</attribute>
				<attribute name="cellFormat" type="string" use="optional"/>
				<attribute name="thresholdFormat" type="string" use="optional"/>
				<attribute name="warningFormat" type="string" use="optional"/>
				<attribute name="choiceIndex" type="int" use="optional"/>
				<attribute name="colWidth" type="int" use="optional"/>
				<attribute name="applyMaxValueStyle" type="boolean" use="optional"/>
				<attribute name="thresholdGroupId" type="fews:idStringType" use="optional">
					<annotation>
						<documentation>Optional. If specified, then only thresholds in the specified thresholdGroup are used in the determination of threshold crossings and warningLevels for this timeSeries. If not specified, then thresholds in all thresholdGroups are used.</documentation>
					</annotation>
				</attribute>
			</extension>
		</simpleContent>
	</complexType>
	<complexType name="EnsembleTableTimeSeriesComplexType">
