<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:fews="http://www.wldelft.nl/fews" targetNamespace="http://www.wldelft.nl/fews" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<include schemaLocation="sharedTypes.xsd"/>
	<include schemaLocation="scadaDisplay.xsd"/>
	<include schemaLocation="exportArchiveModule.xsd"/>
	<!--Top-level element Declaration -->
	<element name="reports" type="fews:ReportsComplexType"/>
	<!--The root element-->
	<complexType name="ReportsComplexType">
		<sequence>
			<element name="declarations" type="fews:ReportsDeclarationsComplexType"/>
			<element name="report" type="fews:ReportComplexType" maxOccurs="unbounded"/>
		</sequence>
		<attribute name="version" type="fews:versionStringType" use="required" fixed="1.0"/>
	</complexType>
	<!--Reports Complex Type-->
	<complexType name="ReportsDeclarationsComplexType">
		<sequence>
			<element name="defineGlobal" type="fews:ReportValueComplexType" minOccurs="0" maxOccurs="unbounded"/>
			<element name="chartFormat" type="fews:ChartFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Chart declaration for reports.</documentation>
				</annotation>
			</element>
			<element name="summaryFormat" type="fews:ReportSummaryFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Summary declaration for reports.</documentation>
				</annotation>
			</element>
			<element name="tableFormat" type="fews:ReportTableFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Table declaration for reports.</documentation>
				</annotation>
			</element>
			<element name="htmlTableFormat" type="fews:ReportHtmlTableFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>HTML Table declaration for reports.</documentation>
				</annotation>
			</element>
			<element name="rowPerLocationHtmlTableFormat" type="fews:RowPerLocationHtmlTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>A rowPerLocationHtmlTable displays for each location one row with attributes and values. Values are computed using the configured function .</documentation>
				</annotation>
			</element>
			<element name="rowPerLocationCsvTableFormat" type="fews:RowPerLocationCsvTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>A rowPerLocationCsvTable displays for each location one row with attributes and values. Values are computed using the configured function</documentation>
				</annotation>
			</element>
			<element name="rowPerEventTimeHtmlTableFormat" type="fews:RowPerEventTimeHtmlTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>SINCE 2016.01. A rowPerEventHtmlTable displays for each event time  one row with several columns. Content of each column is computed using the configured function in that column</documentation>
				</annotation>
			</element>
			<element name="thresholdsCrossingsTable" type="fews:ReportThresholdsCrossingsTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Thresholds Crossings Overview in a table</documentation>
				</annotation>
			</element>
			<element name="thresholdCrossingCountsTableFormat" type="fews:ReportThresholdCrossingCountsTableFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Format declaration for a ThresholdCrossingCountsTable. The table displays threshold crossing counts depending on which thresholds have been crossed within a given time period.</documentation>
				</annotation>
			</element>
			<element name="flagCountsTableFormat" type="fews:ReportFlagCountsTableFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Format declaration for a FlagCountsTable. A FlagCountsTable displays flag counts depending on the flags of the values in a time series within a given time period.</documentation>
				</annotation>
			</element>
			<element name="flagSourceCountsTableFormat" type="fews:ReportFlagSourceCountsTableFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Format declaration for a FlagSourceCountsTable. A FlagSourceCountsTable displays counts of flag sources depending on the flag sources of the values in a time series within a given time period. The flag source for a value contains the reason why that value got a certain flag. For example if a value was rejected by a "hard max" validation rule, then it gets flag unreliable and flag source "hard max".</documentation>
				</annotation>
			</element>
			<element name="ratingCurveTableFormat" type="fews:ReportRatingCurveTableFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2014.02</documentation>
				</annotation>
			</element>
			<element name="ensembleThresholdsTable" type="fews:ReportEnsembleThresholdsTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Overview of the stability of the ensemble forecast in predicting the threshold crossings</documentation>
				</annotation>
			</element>
			<element name="maximumStatusTable" type="fews:ReportMaximumStatusTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Maximum Status Overview in a table</documentation>
				</annotation>
			</element>
			<element name="mergedPrecipitationTable" type="fews:ReportMergedPrecipitationTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Merged Precipitation Overview in a table</documentation>
				</annotation>
			</element>
			<element name="modifierSummariesTableFormat" type="fews:ReportModifierSummariesTableFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Format for a modifier summaries table.</documentation>
				</annotation>
			</element>
			<element name="forecastPerformanceTableFormat" type="fews:ForecastPerformanceTableFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2014.02. FEWS-11254. todo Jitka add doc</documentation>
				</annotation>
			</element>
			<element name="forecastStatisticsTableFormat" type="fews:ForecastStatisticsTableFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2014.02. FEWS-11254. todo Jitka add doc</documentation>
				</annotation>
			</element>
			<element name="statusFormat" type="fews:ReportQueryListFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Status lists declaration for reports.</documentation>
				</annotation>
			</element>
			<element name="systemStatusTable" type="fews:SystemStatusTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>System Status Information in a table</documentation>
				</annotation>
			</element>
			<element name="floodScenarioFormat" type="fews:FloodScenarioFormatComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2018.01 Format of the floodScenario report</documentation>
				</annotation>
			</element>
			<element name="dateFormat" type="fews:ReportDateFormatComplexType" minOccurs="0" maxOccurs="unbounded"/>
			<element name="numberFormat" type="fews:ReportValueComplexType" minOccurs="0" maxOccurs="unbounded"/>
			<element name="units" type="fews:unitSystemEnumStringType" default="user" minOccurs="0">
				<annotation>
					<documentation>Use 'user' to show the values in display units. Use 'system' to show the values in Fews intern (system) units. Default is 'user'</documentation>
				</annotation>
			</element>
			<element name="generatePdf" type="fews:booleanStringType" minOccurs="0">
				<annotation>
					<documentation>Enable to generate each report html as a pdf, in the global.properties the option REPORT_HTML2PDF_PROGRAM should be set to the path of the conversion program or shell script.</documentation>
				</annotation>
			</element>
			<element name="generatePdfCommandLineOptions" type="string" minOccurs="0">
				<annotation>
					<documentation>Extra command line options passed to the wkhtmltopdf.exe, see https://wkhtmltopdf.org/usage/wkhtmltopdf.txt. Eg --orientation Landscape</documentation>
				</annotation>
			</element>
			<element name="generateImage" minOccurs="0">
				<annotation>
					<documentation>Enable to generate each html as an image of the specified format/extension, in the global.properties the option REPORT_HTML2IMG_PROGRAM should be set to the path of the conversion program or shell script.</documentation>
				</annotation>
				<complexType>
					<sequence>
						<element name="format" type="string" minOccurs="0">
							<annotation>
								<documentation>Image format file extension (i.e. PNG / JPG / BMP, default is JPG)</documentation>
							</annotation>
						</element>
						<element name="options" type="string" minOccurs="0">
							<annotation>
								<documentation>Command line options (i.e. --width 720) to be provided to the image conversion program.</documentation>
							</annotation>
						</element>
					</sequence>
				</complexType>
			</element>
			<element name="templateDir" type="fews:fileStringType" minOccurs="0">
				<annotation>
					<documentation>Deprecated, no longer used. Report templates can be placed in the config folder ReportTemplateFiles (since 2017.02)</documentation>
				</annotation>
			</element>
			<element name="reportsRootDir" type="fews:fileStringType"/>
			<element name="reportsRootSubDir" type="string" minOccurs="0">
				<annotation>
					<documentation>Empty string only allowed for backward compatibility</documentation>
				</annotation>
			</element>
			<choice minOccurs="0">
				<element name="sendToLocalFileSystem" type="fews:booleanStringType">
					<annotation>
						<documentation>When true the reports are saved to the file system INSTEAD of saving them in the datastore
                        </documentation>
					</annotation>
				</element>
				<element name="temporary" type="boolean">
					<annotation>
						<documentation>Since 2015.01. When temporary the reports are only available for the report export module executed in the same run. The reports are not saved to the database but instead to a temp file that is deleted at the end of the run</documentation>
					</annotation>
				</element>
				<element name="embedImagesInReport" type="fews:booleanStringType">
					<annotation>
						<documentation>When true Chart images and spatial snapshots will not be stored in the database. In the report template they have to be marked with a IMAGE_BASE64 tag which will embed them in the report itself.</documentation>
					</annotation>
				</element>
			</choice>
			<element name="timeZone" type="fews:TimeZoneComplexType" minOccurs="0">
				<annotation>
					<documentation>report data is converted from GMT to this timezone.</documentation>
				</annotation>
			</element>
			<element name="locale" type="fews:LocaleComplexType" minOccurs="0"/>
			<!-- Here -->
			<element name="inputVariable" type="fews:VariableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>input variable that can be used in combination with a location filter by multiple reports.  Please NOTE that "schematicStatusDisplay" reports never use the inputVariables from this declaration section !  They use only local variables configured in the "schematicStatusDisplay"  report</documentation>
				</annotation>
			</element>
			<choice minOccurs="0">
				<annotation>
					<documentation>
						Since 2023.02. Optional choice for storing export status in the database (table ExportStatus). If this choice is omitted, export status will be stored in database using the
						export folder name as dataFeedId.
					</documentation>
				</annotation>
				<element name="dataFeedId" type="fews:idStringType">
					<annotation>
						<documentation>Id for data feed. Export status will be stored in database using this id</documentation>
					</annotation>
				</element>
				<element name="disableDataFeedInfo" type="fews:emptyElement">
					<annotation>
						<documentation>Option disableDataFeedInfo indicates that no export status should be stored in database</documentation>
					</annotation>
				</element>
			</choice>
		</sequence>
	</complexType>
	<!-- Declarations for Reports Complex Type-->
	<!--Report Complex Type-->
	<complexType name="ReportComplexType">
		<sequence>
			<choice minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>the (parent) location (sets) specifies a filter for the locations in the input and output variables
                    This makes it possible to reuse the input variables specified in the declaration section </documentation>
				</annotation>
				<element name="locationId" type="fews:idStringType"/>
				<element name="locationSetId" type="fews:idStringType"/>
			</choice>
			<choice minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>the (parent) location (sets) specifies a filter for the locations in the input and
                        output variables
                        This makes it possible to reuse the input variables specified in the declaration
                        section</documentation>
				</annotation>
				<element name="parentLocationId" type="fews:idStringType"/>
				<element name="parentLocationSetId" type="fews:idStringType"/>
			</choice>
			<choice minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Define with locations can provide threshold value sets.
                        By default all visible locations in a plot can provide threshold value sets.
                        When multiple threshold values sets are active in one sub plot all thresholds are hidden for this
                        plot.
                    </documentation>
				</annotation>
				<element name="thresholdLocationId" type="fews:idStringType"/>
				<element name="thresholdLocationSetId" type="fews:idStringType"/>
			</choice>
			<element name="inputVariable" type="fews:VariableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>input variable.</documentation>
				</annotation>
			</element>
			<element name="fileResource" type="fews:ReportValueComplexType" minOccurs="0" maxOccurs="unbounded"/>
			<element name="chart" type="fews:ChartReportChartComplexType" minOccurs="0" maxOccurs="unbounded"/>
			<element name="displayChart" type="fews:ReportDisplayChartComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>This element can be used to insert a chart into a report by direct reference to an existing display ID in the displaygroups.	Use the $CHART(chartId)$ tag in the HTML template.
						In case of automatically populated displays (eg singleLocationDisplays), use the name of the display. Available since 2021.01
					</documentation>
				</annotation>
			</element>
			<element name="ratingCurveChart" type="fews:RatingCurveChartComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2014.02  Rating curve charts show the rating curves  that are valid for the timeZero of the Reports module run.</documentation>
				</annotation>
			</element>
			<element name="summary" type="fews:ReportSummaryInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Objects declarations for reports. Can be summary, chart, table or grid
                        plot.</documentation>
				</annotation>
			</element>
			<element name="table" type="fews:ReportTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Objects declarations for reports. Can be summary, chart, table or grid
                        plot.</documentation>
				</annotation>
			</element>
			<element name="htmlTable" type="fews:ReportTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Objects declarations for reports. Can be summary, chart, table or video.
                    </documentation>
				</annotation>
			</element>
			<element name="thresholdLabelTable" type="fews:ThresholdLabelTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Displays highest threshold crossing label and color per location per time step</documentation>
				</annotation>
			</element>
			<element name="valuePropertiesTags" type="fews:ValuePropertiesTagsComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Creates report based on templates in which it replaces value properties within $$, location attributes within @@ and replaces special tags with dedicated functionality within %%</documentation>
				</annotation>
			</element>
			<element name="hwLwHtmlTable" type="fews:ReportHwLwTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Html table with  HW (high water) and LW (low water) indicators in the time series event  columns.  HW is used when the event value is positive, LW is used when the event value is negative.</documentation>
				</annotation>
			</element>
			<element name="ratingCurveTable" type="fews:ReportRatingCurveTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2014.02  Rating curve tables show the rating curves  that are valid for the timeZero of the Reports module run.</documentation>
				</annotation>
			</element>
			<group ref="fews:RowPerLocationHtmlTableGroup" minOccurs="0" maxOccurs="unbounded"/>
			<group ref="fews:RowPerLocationCsvTableGroup" minOccurs="0" maxOccurs="unbounded"/>
			<element name="rowPerEventTimeHtmlTable" type="fews:RowPerEventTimeHtmlTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>SINCE 2016.01. A rowPerEventHtmlTable displays for each event time  one row with several columns. Content of each column is determined using the configured function in that column</documentation>
				</annotation>
			</element>
			<element name="mp4" type="fews:AnimationComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2024.01. Objects declarations for video in MP4 format.
						add this to your html template
						<![CDATA[<embed src="$MP4(myId)$" controls="true" autoplay="true" loop="true">]]></documentation>
				</annotation>
			</element>
			<element name="avi" type="fews:AnimationComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Deprecated and obsolete since 2026.01</documentation>
				</annotation>
			</element>
			<element name="animatedGif" type="fews:AnimationComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Deprecated and obsolete since 2026.01</documentation>
				</annotation>
			</element>
			<element name="spatialPlotSnapshots" type="fews:SpatialPlotSnapshotsComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Same as mp4, but now you can take snapshots from the mp4 that are saved as png files. In the template
                    you can use $SPATIAL_PLOT(plotId). You can make multiple snapshots in one go.</documentation>
				</annotation>
			</element>
			<element name="schematicStatusDisplayPanelMp4" type="fews:SchematicStatusDisplayPanelAnimationComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2013.01. FEWS-5228. Add this to your html template
						<![CDATA[<embed src="$SSD_MP4(myId)$" controls="true" autoplay="true" loop="true">]]></documentation>
				</annotation>
			</element>
			<element name="schematicStatusDisplayPanelAvi" type="fews:SchematicStatusDisplayPanelAnimationComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Deprecated and obsolete since 2026.01</documentation>				</annotation>
			</element>
			<element name="schematicStatusDisplayPanelAnimatedGif" type="fews:SchematicStatusDisplayPanelAnimationComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Deprecated and obsolete since 2026.01</documentation>
				</annotation>
			</element>
			<element name="schematicStatusDisplayPanelSnapshotsPng" type="fews:SchematicStatusDisplayPanelSnapshotsComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2013.01. FEWS-5228. In the template you can use $SSD_PNG(myId)$. You can make multiple snapshots in one go.</documentation>
				</annotation>
			</element>
			<element name="schematicStatusDisplayPanelSnapshotsSvg" type="fews:SchematicStatusDisplayPanelSnapshotsComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2013.01. FEWS-5228. In the template you can use $SSD_SVG(myId)$. You can make multiple snapshots in one go.</documentation>
				</annotation>
			</element>
			<element name="thresholdsCrossingsTable" type="fews:ReportTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Objects declarations for reports. Can be summary, chart, table or
                        avi.</documentation>
				</annotation>
			</element>
			<element name="thresholdCrossingCountsTable" type="fews:ReportTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>One or more ThresholdCrossingCountsTables. The table displays threshold crossing counts depending on which thresholds have been crossed within a given time period.</documentation>
				</annotation>
			</element>
			<element name="flagCountsTable" type="fews:ReportFlagCountsTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>One or more FlagCountsTables. A FlagCountsTable displays flag counts depending on the flags of the values in a time series within a given time period.</documentation>
				</annotation>
			</element>
			<element name="flagSourceCountsTable" type="fews:ReportFlagSourceCountsTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>One or more FlagSourceCountsTables. A FlagSourceCountsTable displays counts of flag sources depending on the flag sources of the values in a time series within a given time period. The flag source for a value contains the reason why that value got a certain flag. For example if a value was rejected by a "hard max" validation rule, then it gets flag unreliable and flag source "hard max".</documentation>
				</annotation>
			</element>
			<element name="ensembleThresholdsTable" type="fews:ReportEnsembleThresholdsTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>This table type displays number of ensemble members  (or % of members)  predicting to be above a defined threshold(s)</documentation>
				</annotation>
			</element>
			<element name="maximumStatusTable" type="fews:ReportTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Objects declarations for reports. Can be summary, chart, table or
                        avi.</documentation>
				</annotation>
			</element>
			<element name="mergedPrecipitationTable" type="fews:ReportTableInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Objects declarations for reports. Can be summary, chart, table or avi.</documentation>
				</annotation>
			</element>
			<element name="modifierSummariesTable" type="fews:ReportModifierSummariesTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>One or more modifier summaries tables. A modifier summaries table shows modifier summaries for all modifiers that have been used in the workflow in which this report is generated.</documentation>
				</annotation>
			</element>
			<element name="forecastPerformanceTable" type="fews:ReportForecastPerformanceTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2014.02</documentation>
				</annotation>
			</element>
			<element name="forecastStatisticsTable" type="fews:ReportForecastStatisticsTableComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2014.02</documentation>
				</annotation>
			</element>
			<element name="status" type="fews:ReportQueryListInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Objects declarations for reports. Can be summary, chart, status or
                        table.</documentation>
				</annotation>
			</element>
			<element name="systemStatusTable" type="fews:SystemTableQueryInstanceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Objects declarations for reports. Can be summary, chart, table or avi.</documentation>
				</annotation>
			</element>
			<element name="statusShapeFile" type="fews:statusShapeFileComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Status Information in an (ESRI) Shape file</documentation>
				</annotation>
			</element>
			<element name="floodScenarioXml" type="fews:FloodScenarioXmlComplexType" minOccurs="0">
				<annotation>
					<documentation>Since 2018.01: Generate a Flood Scenario XML.</documentation>
				</annotation>
			</element>
			<element name="forecastModelResultsXml" type="fews:HyFSModelReportComplexType" minOccurs="0">
				<annotation>
					<documentation>Since 2018.01: Generate a Flood Scenario XML.</documentation>
				</annotation>
			</element>
			<element name="forecastThresholdCrossingXml" type="fews:ForecastThresholdCrossingXmlComplexType" minOccurs="0">
				<annotation>
					<documentation>Since 2018.01: Generate a Forecast Threshold Crossing Xml</documentation>
				</annotation>
			</element>
			<element name="template" type="fews:fileStringType"/>
			<element name="outputSubDir" type="string" minOccurs="0">
				<annotation>
					<documentation>Optional output subdirectory for this report. If singleLocation is true, then outputSubDir can contain location attribute ids, e.g. "H_@BASIN@", where tags between "@" signs refer to location attributes that are defined in the locationSets config file. These tags will be replaced with the corresponding attribute values of the location of the report. These values can be different for different locations. If required to use a "@" sign in this element without using locationAttributes, then need to add an extra escape character "@" before each "@" sign. In other words "@@" is replaced with a single "@" sign.</documentation>
				</annotation>
			</element>
			<element name="outputFileName" type="fews:fileStringType">
				<annotation>
					<documentation>Output file name for this report. If singleLocation is true, then can use tag %LOCATIONID% here, which will be replaced with the id of the location of the report. If singleLocation is true, and the %LOCATIONID% tag is not present, then a "_" sign and the id of the location of the report will be inserted automatically just before the "." sign in the filename. Additionally, if singleLocation is true, then outputFileName can contain location attribute ids, e.g. "H_@BASIN@", where tags between "@" signs refer to location attributes that are defined in the locationSets config file. These tags will be replaced with the corresponding attribute values of the location of the report. These values can be different for different locations. If required to use a "@" sign in this element without using locationAttributes, then need to add an extra escape character "@" before each "@" sign. In other words "@@" is replaced with a single "@" sign.</documentation>
				</annotation>
			</element>
			<element name="outputLineSeparator" type="fews:lineSeparatorEnumStringType" minOccurs="0">
				<annotation>
					<documentation>By default the line separator of the OS is used. The line separator of the used input template is always ignored</documentation>
				</annotation>
			</element>
			<element name="defineLocal" type="fews:ReportValueComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Optional definitions of id value pairs that can be referred to in DEFINITION functions in this report. The template function tag $DEFINITION(defineLocalId)$ will be replaced with the value of the defineLocal element with the corresponding id. If singleLocation is true, then the value of a defineLocal element can contain location attribute ids, e.g. "H_@BASIN@", where tags between "@" signs refer to location attributes that are defined in the locationSets config file. These tags will be replaced with the corresponding attribute values of the location of the report. These values can be different for different locations. If required to use a "@" sign in this element without using locationAttributes, then need to add an extra escape character "@" before each "@" sign. In other words "@@" is replaced with a single "@" sign.</documentation>
				</annotation>
			</element>
			<!-- General string that can be used in a template -->
		</sequence>
		<attribute name="scrubFolder" type="boolean" use="optional" default="false"/>
		<attribute name="sameAxesScale" type="boolean" use="optional" default="false">
			<annotation>
				<documentation>If True all charts in the report have  the same lower and upper bound, even if the configured min,max has been exceeded in one of the charts.</documentation>
			</annotation>
		</attribute>
		<attribute name="singleLocation" type="boolean" use="optional" default="false">
			<annotation>
				<documentation>If True, for each location a separate report  will be created.  Location can be specified using location(Set)Id or parentLocation(Set)Id . By default the locations available in TimeSeriesSets are used.  The report may contain chart and/or htmlTable definitions. Other definitions (such as avi)  are not supported yet in combination with this singleLocation option</documentation>
			</annotation>
		</attribute>
		<attribute name="omitLocationIdInOutputFileName" type="boolean" use="optional" default="false">
			<annotation>
				<documentation>This option is only relevant  if singleLocation is True.  Use omitLocationIdInOutputFileName=True to prevent appending of the locationId to the location outputFileName.
To distinguish the location files, use location attributes instead, for example  report_@LOCNAME@.html</documentation>
			</annotation>
		</attribute>
	</complexType>
