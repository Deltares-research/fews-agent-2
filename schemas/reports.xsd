	<!--Declarations for Ensemble Threshold Crossings Table Complex Type-->
	<complexType name="ReportEnsembleThresholdsTableComplexType">
		<annotation>
			<documentation>This table type displays number of ensemble members  (or % of members)  predicting to be above a defined threshold(s)</documentation>
		</annotation>
		<sequence>
			<choice>
				<element name="numberOfForecasts" type="int">
					<annotation>
						<documentation>Nr.of forecasts to include in the analysis</documentation>
					</annotation>
				</element>
				<element name="searchPeriod" type="fews:RelativePeriodComplexType">
					<annotation>
						<documentation>Relative period before T0 to search for forecasts</documentation>
					</annotation>
				</element>
			</choice>
			<element name="aggregationTimeStep" type="fews:TimeStepComplexType">
				<annotation>
					<documentation>Width of the box for aggregation of thresholds. </documentation>
				</annotation>
			</element>
			<element name="timeHeaderInterval" minOccurs="0">
				<annotation>
					<documentation>Interval =  1 : display each aggregation time step in the header row.  Interval > 1 :  display only each 'interval'-agg.timestep in the header row</documentation>
				</annotation>
				<simpleType>
					<restriction base="int">
						<minInclusive value="1"/>
					</restriction>
				</simpleType>
			</element>
			<element name="timeHeaderDisplayFormat" type="fews:dateTimeFormatType" minOccurs="0">
				<annotation>
					<documentation>Specifies how the time should be displayed in the header row. E.g. HH:mm,  only H possible</documentation>
				</annotation>
			</element>
			<choice>
				<element name="singleThreshold" type="fews:SingleThresholdComplexType">
					<annotation>
						<documentation>Table wil be created for just one level threshold. The colour gradient is used for colouring of the cells. </documentation>
					</annotation>
				</element>
				<element name="thresholdId" type="fews:idStringType" maxOccurs="unbounded">
					<annotation>
						<documentation>Table wil be created for specified level thresholds. The colors for coloring of the cells are taken from the defined attribute map or from the thresholdWarningLevels if no mapId defined.</documentation>
					</annotation>
				</element>
				<element name="thresholdGroupId" type="fews:idStringType">
					<annotation>
						<documentation>Table will be created for all level thresholds in the specified thresholdGroup. The colors for coloring of the cells are taken from the defined attribute map or from the thresholdWarningLevels if no mapId defined.</documentation>
					</annotation>
				</element>
			</choice>
			<element name="scrollableTable" type="boolean" default="false" minOccurs="0">
				<annotation>
					<documentation>Use this to split the table into two parts, one for the header row(s) and one for the data rows. The data row part refers to the tableStyle for this table with "_scrollable" appended. This can be used to make the data rows scrollable while the header row(s) remain fixed. For this to work the referred style needs to be defined in the report tables .css file.</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="mapId" type="fews:idStringType" use="optional">
			<annotation>
				<documentation>Attribute mapId to get the colors of defined thresholds, in case that multiple thresholds are used. Can be overruled in table-instance definition. If mapId not specified, then information from the thresholdWarningLevels config file is used instead of a valueAttributeMap.</documentation>
			</annotation>
		</attribute>
		<attribute name="cellType" type="fews:cellEnumStringType" use="required">
			<annotation>
				<documentation>The value in the cell can be displayed as nr.of members or as percentage of members</documentation>
			</annotation>
		</attribute>
		<attribute name="tableStyle" type="fews:tableStyleEnumStringType" use="required"/>
	</complexType>
	<!-- Declarations for Maximum Status Table Complex Type-->
	<complexType name="ReportMaximumStatusTableComplexType">
		<sequence>
			<element name="mainHeaderText" type="string"/>
