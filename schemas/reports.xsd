				</annotation>
			</element>
			<element name="writeFullModifierDescription" type="fews:emptyElement">
				<annotation>
					<documentation>Since 2016.01  Use this option to write all fields of the modifier descriptor .  If this element is omitted,  only  location name, modifier type id, and modifier summary  are written </documentation>
				</annotation>
			</element>
		</sequence>
	</group>
	<complexType name="SummaryTimeSeriesComplexType">
		<simpleContent>
			<extension base="fews:idStringType">
				<attribute name="mapId" type="string" use="optional">
					<annotation>
						<documentation>If mapId not specified, then information from the thresholdWarningLevels config file is used instead of a valueAttributeMap.</documentation>
					</annotation>
				</attribute>
				<attribute name="thresholdGroupId" type="fews:idStringType" use="optional">
