<schema targetNamespace="http://www.wldelft.nl/fews" xmlns:fews="http://www.wldelft.nl/fews" xmlns="http://www.w3.org/2001/XMLSchema"  elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
    <include schemaLocation="sharedTypes.xsd"/>
    <element name="displayInstanceDescriptors" type="fews:DisplayInstanceDescriptorsComplexType"/>
    <complexType name="DisplayInstanceDescriptorsComplexType">
        <sequence>
            <element name="displayInstanceDescriptor" type="fews:DisplayInstanceDescriptorComplexType" maxOccurs="unbounded">
                <key name="displayInstanceDescriptor">
                    <selector xpath="."/>
                    <field xpath="@id"/>
                </key>
            </element>
        </sequence>
        <attribute name="version" type="fews:versionStringType" use="required" fixed="1.0"/>
    </complexType>
    <complexType name="DisplayInstanceDescriptorComplexType">
        <sequence>
            <element name="description" type="string" minOccurs="0"/>
            <element name="displayId" type="fews:idStringType"/>
        </sequence>
        <attribute name="id" type="fews:idStringType" use="required"/>
        <attribute name="name" type="fews:nameStringType" use="optional"/>
    </complexType>
</schema>
