<?xml version="1.0" encoding="UTF-8"?>
<!--DEPRECATED NO LONGER USED SINCE 2017.02-->
<schema targetNamespace="http://www.wldelft.nl/fews" xmlns:fews="http://www.wldelft.nl/fews" xmlns="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<!-- FewsMasterConfigComplexType -->
	<element name="fews-master-config" type="fews:ObsoleteFewsMasterConfigComplexType"/>
	<!-- FewsMasterConfigComplexType -->
	<complexType name="ObsoleteFewsMasterConfigComplexType">
		<sequence>
			<element name="queueconnection" type="fews:ObsoleteQueueConnectionComplexType" minOccurs="0">
                <annotation>
                    <documentation>If a queueconnection element is defined inside the mc element, this one is ignored (and is optional in that case).</documentation>
                </annotation>
            </element>
			<element name="defaultMcId" type="string" minOccurs="0"/>
			<element name="mc" type="fews:ObsoleteMCComplexType" maxOccurs="unbounded"/>
			<element name="database" type="fews:ObsoleteDatabaseComplexType" minOccurs="0"/>
			<element name="synchronisation" type="fews:ObsoleteSynchronisationComplexType"/>
			<element name="login" type="fews:ObsoleteLoginComplexType" minOccurs="0" />
		</sequence>
	</complexType>
	<!-- QueueConnectionComplexType -->
	<complexType name="ObsoleteQueueConnectionComplexType">
		<sequence>
			<element name="factory" type="fews:ObsoleteFactoryComplexType"/>
		</sequence>
	</complexType>
	<!-- FactoryComplexType -->
	<complexType name="ObsoleteFactoryComplexType">
		<attribute name="jndi" type="string"/>
	</complexType>
	<!-- MCComplexType -->
	<complexType name="ObsoleteMCComplexType">
		<sequence>
			<element name="queueconnection" type="fews:ObsoleteQueueConnectionComplexType" minOccurs="0"/>
			<element name="jndicontext" type="fews:ObsoleteJNDIContextComplexType"/>
			<element name="queue" type="fews:ObsoleteQueueComplexType"/>
		</sequence>
		<attribute name="id" type="string"/>
		<attribute name="name" type="string" use="optional"/>
	</complexType>
	<!-- JNDIContextComplexType -->
	<complexType name="ObsoleteJNDIContextComplexType">
		<attribute name="factory" type="string"/>
		<attribute name="provider" type="string"/>
		<attribute name="prefixes" type="string"/>
	</complexType>
	<!-- QueueComplexType -->
	<complexType name="ObsoleteQueueComplexType">
		<sequence>
			<element name="root" type="fews:ObsoleteRootComplexType"/>
			<element name="synch" type="fews:ObsoleteSynchComplexType"/>
		</sequence>
	</complexType>
	<!-- RootComplexType -->
	<complexType name="ObsoleteRootComplexType">
		<attribute name="jndi" type="string"/>
	</complexType>
	<!-- SynchComplexType -->
	<complexType name="ObsoleteSynchComplexType">
		<attribute name="jndi" type="string"/>
		<attribute name="timeout" type="integer"/>
	</complexType>
	   <!-- LoginComplexType -->
    <complexType name="ObsoleteLoginComplexType">
        <attribute name="timeout" type="integer"/>
    </complexType>
	<!-- DatabaseComplexType -->
	<complexType name="ObsoleteDatabaseComplexType">
		<sequence>
			<element name="connection" type="fews:ObsoleteConnectionComplexType"/>
		</sequence>
		<attribute name="driverclass" type="string"/>
	</complexType>
	<!-- ConnectionComplexType -->
	<complexType name="ObsoleteConnectionComplexType">
		<attribute name="string" type="string"/>
		<attribute name="userid" type="string"/>
		<attribute name="password" type="string"/>
	</complexType>
	<!-- SynchronisationComplexType -->
	<complexType name="ObsoleteSynchronisationComplexType">
		<sequence>
			<element name="messaging" type="fews:ObsoleteMessagingComplexType"/>
			<element name="processor" type="fews:ObsoleteProcessorComplexType"/>
			<element name="schema" type="fews:ObsoleteSchemaComplexType"/>
		</sequence>
	</complexType>
	<!-- MessagingComplexType -->
	<complexType name="ObsoleteMessagingComplexType">
		<attribute name="maxrecords" type="integer"/>
		<attribute name="maxlobdata" type="integer"/>
	</complexType>
	<!-- ProcessorComplexType -->
	<complexType name="ObsoleteProcessorComplexType">
		<attribute name="maxlistsize" type="integer"/>
	</complexType>
	<!-- SchemaComplexType -->
	<complexType name="ObsoleteSchemaComplexType">
		<attribute name="location" type="string"/>
	</complexType>
</schema>
