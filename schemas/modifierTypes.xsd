<schema xmlns:fews="http://www.wldelft.nl/fews" xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.wldelft.nl/fews" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<include schemaLocation="sharedTypes.xsd"/>
	<element name="modifierTypes" type="fews:ModifierTypesComplexType"/>
	<complexType name="ModifierTypesComplexType">
		<sequence>
			<element name="restoreModifiersWhenApprovingForecastRun" type="boolean" default="false" minOccurs="0">
				<annotation>
					<documentation>when this option is enabled, all modifiers which were used in this run will be restored. Modifiers which were created after this run will be deleted</documentation>
				</annotation>
			</element>
			<element name="rollbackOverlappingModifiers" type="boolean" default="true" minOccurs="0">
				<annotation>
					<documentation>If user A creates and commits an modifier which overlaps with a new modifiers from user B than the changes from user B will be rolled back</documentation>
				</annotation>
			</element>
			<element name="autoCommit" type="boolean" default="false" minOccurs="0">
				<annotation>
					<documentation>when this option is enabled. Modifiers are committed after creation or an update and are uploaded directly to the live system
					</documentation>
				</annotation>
			</element>
			<element name="autoExtendExpiryTime" type="boolean" default="false" minOccurs="0">
				<annotation>
					<documentation>Since 2023.02 The expiry time of the modifier is based on the latest time of the modifier plus the configured (or default) expiry time for the modifier type</documentation>
				</annotation>
			</element>
			<element name="missingValueModifier" type="fews:MissingValueModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>This modifier can be used set all the values of a time series to missing for a certain period</documentation>
				</annotation>
			</element>
			<element name="typicalProfileModifier" type="fews:TypicalProfileModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>This modifier allows specification of a typicalProfile which is defined at a certain date time frame, while being applied at systemTime.
						Use the originalSystemTime setting in the GUI to manage the relative start time shift of the modifier values to systemTime.
						Note: this modifier is also offered to the user as one of the options when configuring a the timeseriesModifier</documentation>
				</annotation>
			</element>
			<element name="timeSeriesModifier" type="fews:TimeSeriesModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>This modifier can be used to modify the values of a time series by defining new time value pairs. It is also possible to define an operation like add 2 or divided by
						3 for a certain period. It is also possible to set all the values to missing for a certain period (comparable to the missing value modifier)
					</documentation>
				</annotation>
			</element>
			<element name="constantValueModifier" type="fews:ConstantValueModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>this modifier can be used to set the value of a time series to a constant value for a certain period of time</documentation>
				</annotation>
			</element>
			<element name="singleValueModifier" type="fews:SingleValueModifierTypeComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>this modifier can be used to set a single value of a time series to a different value</documentation>
				</annotation>
			</element>
			<element name="enumerationModifier" type="fews:EnumerationModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>this modifier can be used to set a single value in a time series. The user can choose from a pre-configured set choices (dropdownbox). Each choice is linked to a
						unique value. This value will be stored at the chosen date/time in the time series
					</documentation>
				</annotation>
			</element>
			<element name="markUnreliableModifier" type="fews:MarkUnreliableModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>The modifier can be used to set the values of a time series to unreliable for a certain period of time</documentation>
				</annotation>
			</element>
			<element name="adjustQModifiers" type="fews:AdjustQModifiersComplexType" minOccurs="0">
				<annotation>
					<documentation>Group of modifiers which can be applied on the adjustQ transformations</documentation>
				</annotation>
			</element>
			<element name="timeShiftConstantModifiers" type="fews:TimeShiftConstantModifiersComplexType" minOccurs="0"/>
			<element name="sampleHistoricalModifiers" type="fews:SampleHistoricalModifiersComplexType" minOccurs="0"/>
			<element name="mergeSimpleModifiers" type="fews:MergeSimpleModifiersComplexType" minOccurs="0"/>
			<element name="compoundModifier" type="fews:CompoundModifierComplexType" minOccurs="0" maxOccurs="unbounded"/>
			<element name="highLowSurgeSelectionModifier" type="fews:HighLowSurgeSelectionModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>highLowSurgeSelectionModifier shows the final surge (Stau) forecasts in a tabular overview (Stautabellen)  and allows selecting and editing  of the high/low surge.</documentation>
				</annotation>
			</element>
			<element name="switchOptionModifier" type="fews:SwitchOptionModifierComplexType" minOccurs="0" maxOccurs="unbounded"/>
			<element name="optionModifier" type="fews:OptionModifierComplexType" minOccurs="0" maxOccurs="unbounded"/>
			<element name="moduleParameterModifier" type="fews:ModuleParameterModifierComplexType" minOccurs="0" maxOccurs="unbounded"/>
			<element name="priorityModifier" type="fews:PriorityModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2014.02. Modifier by which module parameter type 'table' can be modified. This modifier presently supports reordening of the table rows.</documentation>
				</annotation>
			</element>
			<element name="multipleModuleParameterModifier" type="fews:MultipleModuleModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Modifier by which multiple module parameter files can be modified in one display. It is possible define rules and constraints for the modifier</documentation>
				</annotation>
			</element>
			<element name="spatialCopyModifier" type="fews:SpatialModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2019.02 The user can copy parts of another grid time series using the modifier mode in the grid display.</documentation>
				</annotation>
			</element>
			<element name="spatialProfileModifier" type="fews:SpatialProfileModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2019.02 The user can select an area in a grid and define a scalar time series to set a constant value for all the grid cells in the selected area for each time step. This is done using the modifier mode in the grid display.</documentation>
				</annotation>
			</element>
			<element name="unitHydrographModifiers" type="fews:UnitHydrographModifiersComplexType" minOccurs="0">
				<annotation>
					<documentation>Group of modifiers for the unit hydrograph model (currently only of modifier is available)</documentation>
				</annotation>
			</element>
			<element name="mergeWeightedModifiers" type="fews:MergeWeightedModifiersComplexType" minOccurs="0"/>
			<element name="ratingCurveModifiers" type="fews:RatingCurveModifiersComplexType" minOccurs="0"/>
			<element name="attributeModifiers" type="fews:AttributeModifiersComplexType" minOccurs="0">
				<annotation>
					<documentation>Group of modifiers which can be used to modify attributes</documentation>
				</annotation>
			</element>
			<element name="modifiersGroup" type="fews:ModifiersGroupComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>In this elements groups of modifiers can be defined. In de workflowdescriptors can be defined which modifiers should be included in run. If no groups are defined all modifiers are included. Also in the topology modifier groups can be used. For example to define which mods can be viewed or modded at a certain node.</documentation>
				</annotation>
			</element>
			<element name="copyModifiers" type="fews:CopyModifierComplexType" minOccurs="0">
				<annotation>
					<documentation>Since 2018.02 The user can copy modifiers by using the "option</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<group name="OneDateModifierDatesGroup">
		<sequence>
			<element name="defaultTime" type="fews:DefaultStartTimeEnumStringType">
				<annotation>
					<documentation>Start of time period to which modifier is applied. When omitted this value will default to the Year 1000 and will be disabled.
					</documentation>
				</annotation>
			</element>
			<element name="offsetDefaultTime" type="fews:TimeShiftComplexType" minOccurs="0"/>
		</sequence>
	</group>
	<group name="PeriodModifierDatesGroup">
		<sequence>
			<element name="defaultStartTime" type="fews:DefaultStartTimeEnumStringType">
				<annotation>
					<documentation>Start of time of the period to which modifier is applied. When omitted this value will default to the Year 1000 and will be disabled.</documentation>
				</annotation>
			</element>
			<element name="offsetDefaultStartTime" type="fews:TimeShiftComplexType" minOccurs="0">
				<annotation>
					<documentation>Define an offset to the default start time.</documentation>
				</annotation>
			</element>
			<element name="defaultEndTime" type="fews:DefaultEndTimeEnumStringType">
				<annotation>
					<documentation>End of time period to which modifier is applied. When omitted this value will default to the Year 3000 and will be disabled.
					</documentation>
				</annotation>
			</element>
			<element name="offsetDefaultEndTime" type="fews:TimeShiftComplexType" minOccurs="0">
				<annotation>
					<documentation>Define an offset to the default end time.</documentation>
				</annotation>
			</element>
			<element name="defaultValidTime" type="fews:emptyElement" minOccurs="0">
				<annotation>
					<documentation>Forecast time after which the modifier is no longer valid. When omitted this value will default to the Year 3000 and will be disabled.
					</documentation>
				</annotation>
			</element>
			<element name="offsetValidTime" type="fews:TimeShiftComplexType" minOccurs="0">
				<annotation>
					<documentation>Define an offset to the default valid time.</documentation>
				</annotation>
			</element>
		</sequence>
	</group>
	<complexType name="MissingValueModifierComplexType">
		<complexContent>
			<extension base="fews:TimeSeriesModifierBaseComplexType">
				<sequence>
					<element name="timeSeries" type="fews:TimeSeriesFilterComplexType" minOccurs="0" maxOccurs="unbounded">
						<annotation>
							<documentation>Filter which defines which time series can be modified with this modifier</documentation>
						</annotation>
					</element>
					<group ref="fews:PeriodModifierDatesGroup" minOccurs="0"/>
					<element name="resolveInWorkflow" type="boolean"/>
					<element name="resolveInPlots" type="boolean"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="TypicalProfileModifierComplexType">
		<complexContent>
			<extension base="fews:TimeSeriesModifierBaseComplexType">
				<sequence>
					<element name="timeSeries" type="fews:TimeSeriesFilterComplexType" minOccurs="0" maxOccurs="unbounded">
						<annotation>
							<documentation>Filter which defines which time series can be modified with this modifier</documentation>
						</annotation>
					</element>
					<group ref="fews:PeriodModifierDatesGroup" minOccurs="0"/>
					<element name="resolveInWorkflow" type="boolean"/>
					<element name="resolveInPlots" type="boolean"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="UnitHydrographModifiersComplexType">
		<sequence>
			<element name="changeOrdinatesModifier" type="fews:ChangeOrdinatesModifierComplexType">
				<annotation>
					<documentation>Modifier which allows the modification of the hydrograph of NWS UNITHG model</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="SharedLocationAttributeModifiersComplexType">
		<sequence>
			<choice>
				<element name="locationId" type="fews:idStringType" maxOccurs="unbounded">
					<annotation>
						<documentation>Set of locations which can be modified by all location attribute modifiers</documentation>
					</annotation>
				</element>
				<element name="locationSetId" type="fews:idStringType">
					<annotation>
						<documentation>The location set which can be modified by all location attribute modifiers</documentation>
					</annotation>
				</element>
			</choice>
			<element name="attribute" type="fews:idStringType" maxOccurs="unbounded">
				<annotation>
					<documentation>The location attributes which can be modified by all location attribute modifiers</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="AttributeModifiersComplexType">
		<sequence>
			<element name="sharedLocationAttributeModifiers" type="fews:SharedLocationAttributeModifiersComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>A set of attributes and locations which can be modified by all location attribute modifiers</documentation>
				</annotation>
			</element>
			<element name="locationAttributeModifier" type="fews:LocationAttributeModifierComplexType" minOccurs="0" maxOccurs="unbounded">
			<annotation>
					<documentation>This modifier can be used to modify location attributes</documentation>
				</annotation>
			</element>
			<element name="shiftDateTimeModifier" type="fews:ShiftDateTimeLocationAttributeModifierComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>This modifier can be used to define a single location attribute date modifier. The defined modifier will have a valid time. If the time zero of a task run is after the defined valid time then the modifier won't be applied. This modifier can be used in combination with the forecast length estimator to shift the time zero of a run.</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="ShiftDateTimeLocationAttributeModifierComplexType">
		<complexContent>
			<extension base="fews:ModifierBaseComplexType">
				<sequence>
					<element name="attributeId" type="fews:idStringType"/>
					<choice>
						<element name="locationId" type="fews:idStringType" maxOccurs="unbounded"/>
						<element name="locationSetId" type="fews:idStringType"/>
					</choice>
					<element name="defaultModifierTime" type="fews:DefaultModifierTimeComplexType"/>
					<element name="customLabel" type="fews:nameStringType">
						<annotation>
							<documentation>The text of the label which will appear in front of the date/time picker in the modifier panel</documentation>
						</annotation>
					</element>
					<element name="editablePeriodTimeSeries" type="fews:TimeSeriesSetComplexType">
						<annotation>
							<documentation>The time which the users selects in the modifier should be in the period for which the defined time series have reliable data.</documentation>
						</annotation>
					</element>
					<element name="offsetValidTime" type="fews:TimeShiftComplexType" minOccurs="0">
						<annotation>
							<documentation>Define an offset to the default valid time.</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="DefaultModifierTimeComplexType">
		<sequence>
			<element name="offset" type="fews:TimeShiftComplexType"/>
			<element name="timeStep" type="fews:TimeStepComplexType"/>
		</sequence>
	</complexType>
	<complexType name="LocationAttributeModifierComplexType">
		<complexContent>
			<extension base="fews:ModifierBaseComplexType">
				<sequence>
					<element name="exportFile" type="fews:LocationAttributeModifierExportFileComplexType" minOccurs="0">
						<annotation>
							<documentation>If an export file is configured it will be possible to export the content of a location attribute modifier to a file from the modifier panel</documentation>
						</annotation>
					</element>
					<element name="ignoreNonExistingAttributes" type="boolean" default="false" minOccurs="0">
						<annotation>
							<documentation>Since 2020.02 If the configured attributes are not found, they will be ignored. In addition FEWS will not an error message!</documentation>
						</annotation>
					</element>
					<element name="modifiableGroup" type="fews:ModifiableGroupComplexType" minOccurs="0" maxOccurs="unbounded">
						<annotation>
							<documentation>Define a group a locations from which a certain subset of attributes can be modified.</documentation>
						</annotation>
					</element>
					<element name="template" type="fews:TemplateListItemComplexType" minOccurs="0"/>
					<element name="storeAllAttributesValues" type="boolean" default="false" minOccurs="0">
						<annotation>
							<documentation>Since 2025.01 If this option is enabled all the current values of attributes will be stored in the modifier. This option is only available for the location
								attribute modifier.
							</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="ModifiersGroupComplexType">
		<sequence>
			<element name="modifierId" type="fews:idStringType" maxOccurs="unbounded"/>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
	</complexType>
	<complexType name="TemplateListItemComplexType">
		<sequence>
			<choice maxOccurs="unbounded">
				<element name="panel" type="fews:PanelComplexType"/>
			</choice>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="name" type="fews:nameStringType"/>
	</complexType>
	<complexType name="PanelComplexType">
		<sequence>
			<element name="panelId" type="string"/>
			<group ref="fews:PanelLayoutGroupComplexType" minOccurs="0"/>
		</sequence>
	</complexType>
	<group name="PanelLayoutGroupComplexType">
		<sequence>
			<element name="position" type="fews:PositionComplexType"/>
		</sequence>
	</group>
	<complexType name="PositionComplexType">
		<attribute name="column" type="integer"/>
		<attribute name="row" type="integer"/>
	</complexType>
	<complexType name="TabLayoutComplexType">
		<sequence>
			<element name="showOriginalValues" type="boolean" default="true" minOccurs="0">
				<annotation>
					<documentation>When this option is enabled the table will show the original (unmodified) values for the attributes</documentation>
				</annotation>
			</element>
			<element name="locationOrientation" type="fews:LocationOrientationSimpleType" default="column" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="PanelLayoutComplexType">
		<sequence>
			<choice maxOccurs="unbounded">
				<element name="locationListLayout" type="fews:LocationListLayoutComplexType"/>
				<element name="tableLayout" type="fews:TableLayoutComplexType"/>
			</choice>
		</sequence>
	</complexType>
	<simpleType name="LocationOrientationSimpleType">
		<restriction base="string">
			<enumeration value="row"/>
			<enumeration value="column"/>
		</restriction>
	</simpleType>
	<complexType name="TableLayoutComplexType">
		<sequence>
			<element name="title" type="string"/>
			<element name="defaultColumnWidth" type="fews:positiveInteger" minOccurs="0">
				<annotation>
					<documentation>Since 2017.02 This option can be used to define the default column width of a column. This default is used when there is no width defined for an attribute
					</documentation>
				</annotation>
			</element>
			<element name="attributeId" type="fews:AttributeIdComplexType" maxOccurs="unbounded"/>
			<element name="locationOrientation" type="fews:LocationOrientationSimpleType" default="column" minOccurs="0"/>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="width" type="fews:positiveInteger">
			<annotation>
				<documentation>Since 2017.02 This option can be used to define the width of the panel</documentation>
			</annotation>
		</attribute>
		<attribute name="height" type="fews:positiveInteger">
			<annotation>
				<documentation>Since 2017.02 This option can be used to define the height of the panel</documentation>
			</annotation>
		</attribute>
	</complexType>
	<complexType name="LocationListLayoutComplexType">
		<sequence>
			<element name="title" type="string"/>
			<element name="attributeId" type="fews:AttributeIdComplexType" maxOccurs="unbounded"/>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="width" type="fews:positiveInteger">
			<annotation>
				<documentation>Since 2017.02 This option can be used to define the width of the panel</documentation>
			</annotation>
		</attribute>
		<attribute name="height" type="fews:positiveInteger">
			<annotation>
				<documentation>Since 2017.02 This option can be used to define the height of the panel</documentation>
			</annotation>
		</attribute>
	</complexType>
	<complexType name="AttributeIdComplexType">
		<simpleContent>
			<extension base="fews:idStringType">
				<attribute name="width" type="fews:positiveInteger">
					<annotation>
						<documentation>Since 2017.02 This option can be used to define the width of the column of this attribute</documentation>
					</annotation>
				</attribute>
			</extension>
		</simpleContent>
	</complexType>
	<complexType name="LocationAttributeComplexType">
		<sequence>
			<choice>
				<element name="readOnly" type="boolean" default="false" minOccurs="0"/>
				<element name="visible" type="boolean" default="true" minOccurs="0"/>
			</choice>
			<choice minOccurs="0">
				<element name="timeSeriesValueClosestToStateSelectionStartTime" type="fews:TimeSeriesValueClosestToStateSelectionStartTimeComplexType"/>
				<element name="useSystemTimeAsDefaultValue" type="boolean">
					<annotation>
						<documentation>Since 2020.01. This option is available for date/time attributes. The default value of the attribute will be set to the system time.</documentation>
					</annotation>
				</element>
				<element name="useTimeOfFirstReliableValueInTimeSeries" type="fews:TimeSeriesUseDateOfFirstReliableValueInTimeSeriesComplexType">
					<annotation>
						<documentation>Since 2020.01. This option is available for date/time attributes. The default value of the attribute will be set to the date/time of the first reliable value of
							the configured time series
						</documentation>
					</annotation>
				</element>
				<element name="selection" type="fews:LocationAttributeSelectionComplexType"/>
			</choice>
			<element name="conditionalSelection" type="fews:ConditionalPredefinedLocationAttributeOptionsComplexType" minOccurs="0">
				<annotation>
					<documentation>Define a list of pre-defined options by which a certain location attribute can be modified</documentation>
				</annotation>
			</element>
			<element name="comment" type="string" minOccurs="0">
				<annotation>
					<documentation>Define an comment for this attribute. This comment will appear in the lower panel of the modifier panel when this attribute is selected.</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
	</complexType>
	<complexType name="LocationAttributeTableComplexType">
		<sequence>
			<element name="attributeId" type="fews:TableAttributeIdComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>Location attributei id  .   The attribute may have multiple values</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="name" type="fews:nameStringType" use="optional"/>
	</complexType>
	<complexType name="TableAttributeIdComplexType">
		<simpleContent>
			<extension base="fews:idStringType">
				<attribute name="readOnly" type="boolean" default="false"/>
			</extension>
		</simpleContent>
	</complexType>
	<complexType name="TimeSeriesUseDateOfFirstReliableValueInTimeSeriesComplexType">
		<sequence>
			<element name="timeSeriesSet" type="fews:TimeSeriesSetComplexType">
				<annotation>
					<documentation>Since 2017.02 The value of the attribute modifier will be derived from the value which this time series has at the beginning of the state selection</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="TimeSeriesValueClosestToStateSelectionStartTimeComplexType">
		<sequence>
			<element name="timeSeriesSet" type="fews:TimeSeriesSetComplexType">
				<annotation>
					<documentation>Since 2017.02 The value of the attribute modifier will be derived from the value which this time series has at the beginning of the state selection</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="LocationAttributeConditionalSelectionComplexType">
		<sequence>
			<element name="conditionalPredefined" type="fews:ConditionalPredefinedLocationAttributeOptionsComplexType">
				<annotation>
					<documentation>Since 2014.02. FEWS-11307. With this option it is possible to disable one or more other attributes depending on which option is selected.</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="LocationAttributeSelectionComplexType">
		<sequence>
			<choice minOccurs="0">
				<element name="locationId" type="fews:idStringType" maxOccurs="unbounded"/>
				<element name="locationSetId" type="fews:idStringType"/>
				<element name="predefined" type="fews:PredefinedLocationAttributeOptionsComplexType"/>
				<element name="predefinedInteger" type="fews:PredefinedIntegerLocationAttributeOptionsComplexType"/>
				<element name="optionsControllingLocationAttributeId" type="fews:OptionsControllingLocationAttributeIdComplexType"/>
			</choice>
			<element name="dependentLocationAttributeId" type="fews:OptionsControllingLocationAttributeIdComplexType" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="ConditionalPredefinedLocationAttributeOptionsComplexType">
		<sequence>
			<element name="option" type="fews:OptionComplexType" maxOccurs="unbounded">
				<annotation>
