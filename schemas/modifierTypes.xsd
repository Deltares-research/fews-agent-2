	<complexType name="TimeSeriesModifierComplexType">
		<complexContent>
			<extension base="fews:TimeSeriesModifierBaseComplexType">
				<sequence>
					<element name="timeSeries" type="fews:TimeSeriesFilterComplexType" minOccurs="0" maxOccurs="unbounded">
						<annotation>
							<documentation>Filter which defines which time series can be modified with this modifier. It is not possible to create a modifier for a time series with a moduleinstance set defined for which there is no data yet in the datastore.</documentation>
						</annotation>
					</element>
					<element name="onlyApplyLastModifier" type="boolean" default="false" minOccurs="0">
						<annotation>
							<documentation>If this option is enabled only the last modifier of this type will be applied to a certain time series</documentation>
						</annotation>
					</element>
					<element name="mergeUnCommittedModifiers" type="boolean" default="false" minOccurs="0">
						<annotation>
							<documentation>Since 2017.02. If this option is enabled uncommitted modifiers will be merged into one modifier. This option is limited to modifiers which modify single time series</documentation>
						</annotation>
					</element>
					<element name="referenceTimeSeries" type="fews:TimeSeriesFilterComplexType" minOccurs="0" maxOccurs="unbounded">
						<annotation>
							<documentation>Filter to define reference time series. These time series are shown in the modifier panel but can not be modified and are only shown for reference purposes. Only reference time series which belong to the same parameter group and have the same locatoin(s) as the time series which are being modified will be shown in the display.
							</documentation>
						</annotation>
					</element>
					<element name="softLimits" type="fews:SoftLimitsComplexType" minOccurs="0"/>
					<element name="hardLimits" type="fews:HardLimitsComplexType" minOccurs="0"/>
					<group ref="fews:PeriodModifierDatesGroup" minOccurs="0"/>
					<element name="resolveInWorkflow" type="boolean">
						<annotation>
							<documentation>search for timeseries in the currently selected workflow. In a IFD environment the selected topology node will provide the selected workflow
							</documentation>
						</annotation>
					</element>
					<element name="resolveInPlots" type="boolean">
						<annotation>
							<documentation>search for time series in the plots of the currently selected topology node
							</documentation>
						</annotation>
					</element>
					<choice>
						<element name="editInPlots" type="boolean" default="true" minOccurs="0">
							<annotation>
								<documentation>Allow to graphically create time series modifiers in the plot display or by changes values in the table. If this option is disabled, it is only allowed
									to create this modifier in the modifier display
								</documentation>
							</annotation>
						</element>
						<element name="graphicalEditing" type="boolean" default="true" minOccurs="0">
							<annotation>
								<documentation>Allow to create times series modifiers by graphical editing. If this option is disabled it is only possible to create mods in modifier display and by
									editing in the table of the plots
								</documentation>
							</annotation>
						</element>
					</choice>
					<element name="perEnsembleMember" type="boolean" default="false" minOccurs="0">
						<annotation>
							<documentation>Since 2014.02 FEWS-11272. if this option is enabled (default is disabled) the modifiers will be created for a single ensemble member</documentation>
						</annotation>
					</element>
					<element name="createContinuousModifiers" type="boolean" default="true" minOccurs="0">
						<annotation>
							<documentation>if this option is disabled and a modifier is graphically created in the plot display, for each continuous period of changes a modifier is created. By default
								for each editting sequence a modifier will be created.
							</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="SpatialModifierComplexType">
		<complexContent>
			<extension base="fews:ModifierBaseComplexType">
				<sequence>
					<element name="timeSeries" type="fews:TimeSeriesFilterComplexType" maxOccurs="unbounded">
						<annotation>
							<documentation>Filter which defines which time series can be modified with this modifier.</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="SpatialProfileModifierComplexType">
		<complexContent>
			<extension base="fews:SpatialModifierComplexType">
				<sequence>
					<element name="descriptiveFunctionGroups" type="fews:SpatialProfileDescriptiveStatisticalFunctionGroupsComplexType" minOccurs="0">
						<annotation>
							<documentation>Descriptive statistical functions</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="SpatialProfileDescriptiveStatisticalFunctionGroupsComplexType">
		<annotation>
			<documentation>Groups of Descriptive Statistics Functions: has at least one Descriptive Statistics Functions group. A separate statistics table will be created for each group.</documentation>
		</annotation>
		<sequence>
			<group ref="fews:DescriptiveStatisticalFunctionGroupsGroup"/>
		</sequence>
	</complexType>
	<complexType name="CopyModifierComplexType">
		<sequence>
			<element name="timeSeriesModifiersPattern" type="fews:CopyModifiersPatternComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>Since 2018.02 define a pattern which will be used to copy modifiers.</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="CopyModifiersPatternComplexType">
		<sequence>
			<element name="pattern" type="string">
				<annotation>
					<documentation>Since 2018.02 Definition of the pattern which should be replaced when the modifier is copied to another modifier.</documentation>
				</annotation>
			</element>
			<element name="patternDescription" type="string">
				<annotation>
					<documentation>Since 2018.02 Description of the pattern which will be used in the display.</documentation>
				</annotation>
			</element>
			<element name="topologyNodeId" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>Since 2025.01 Id of the topology node which will be used to copy the modifiers.</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<simpleType name="DefaultStartTimeEnumStringType">
		<restriction base="string">
			<enumeration value="start run"/>
			<enumeration value="time zero"/>
		</restriction>
	</simpleType>
	<simpleType name="DefaultEndTimeEnumStringType">
		<restriction base="string">
			<enumeration value="start run"/>
			<enumeration value="time zero"/>
			<enumeration value="end run"/>
		</restriction>
	</simpleType>
	<complexType name="SampleHistoricalModifiersComplexType">
		<sequence>
			<element name="sampleYearsModifier" type="fews:SampleYearsModifierComplexType"/>
		</sequence>
	</complexType>
	<complexType name="SampleYearsModifierComplexType">
		<complexContent>
			<extension base="fews:ModifierBaseComplexType"/>
		</complexContent>
	</complexType>
	<complexType name="AdjustQModifiersComplexType">
		<sequence>
			<element name="blendingStepsModifier" type="fews:BlendingStepsModifierComplexType" minOccurs="0">
				<annotation>
					<documentation>With this modifier the amount of blending steps used in the adjustQ transformation can be modified. The blending steps define in how many steps the observed
						discharged values will "blend" to the simulated discharge values
					</documentation>
				</annotation>
			</element>
			<element name="disableAdjustmentModifier" type="fews:DisableAdjustmentModifierComplexType" minOccurs="0">
				<annotation>
					<documentation>With this modifier it is possible to disable the adjustQ transformation</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="DisableAdjustmentModifierComplexType">
		<complexContent>
			<extension base="fews:ModifierBaseComplexType"/>
		</complexContent>
	</complexType>
	<complexType name="BlendingStepsModifierComplexType">
		<complexContent>
			<extension base="fews:ModifierBaseComplexType"/>
		</complexContent>
	</complexType>
	<complexType name="TimeShiftConstantModifiersComplexType">
		<sequence>
			<element name="timeShiftModifier" type="fews:TimeShiftConstantModifierComplexType"/>
		</sequence>
	</complexType>
	<complexType name="TimeShiftConstantModifierComplexType">
		<complexContent>
			<extension base="fews:ModifierBaseComplexType"/>
		</complexContent>
	</complexType>
	<complexType name="MergeSimpleModifiersComplexType">
		<sequence>
			<element name="reverseOrderModifiers" type="fews:ReverseOrderModifiersComplexType" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<complexType name="ReverseOrderModifiersComplexType">
		<complexContent>
			<extension base="fews:ModifierBaseComplexType">
				<sequence>
					<group ref="fews:PeriodModifierDatesGroup" minOccurs="0"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="TimeSeriesModifierBaseComplexType">
		<complexContent>
			<extension base="fews:ModifierBaseComplexType">
				<sequence>
					<element name="useLocationLongName" type="boolean" default="false" minOccurs="0">
						<annotation>
							<documentation>Since 2014.02. FEWS-11310. If this option is set to true than the location selection panel shows the long name, the default is true</documentation>
						</annotation>
					</element>
					<element name="applyToDeterministicRun" type="boolean" minOccurs="0">
						<annotation>
							<documentation>If this option is set to true then the modifier will only apply to deterministic runs.</documentation>
						</annotation>
					</element>
					<element name="applyToEnsemble" type="fews:idStringType" minOccurs="0" maxOccurs="unbounded">
						<annotation>
							<documentation>If you have configured ensemble ids in this section, the modifier will only apply to the configured ensemble ids.</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="ModifierBaseComplexType">
		<sequence>
			<element name="modifierTypeDescription" type="string" minOccurs="0"/>
			<element name="expiryTime" type="fews:TimeSpanComplexType" minOccurs="0">
				<annotation>
					<documentation>Define a custom expiry time for the modifier to overrule the default (30 days)</documentation>
				</annotation>
			</element>
			<element name="expiryTimeDeletedModifiers" type="fews:TimeSpanComplexType" minOccurs="0">
				<annotation>
					<documentation>Since 2013.01. FEWS-7744 After the deletion of a modifier the modifier will be set to invisible but the modifier will not be deleted so that it can be restored until
						it reaches the expiry time defined in this element
					</documentation>
				</annotation>
			</element>
			<element name="modifierCardinalTimeStep"  type="fews:TimeStepComplexType" minOccurs="0">
				<annotation>
					<documentation>Define a custom cardinal time step for the modifier type. Available since 2014.02.</documentation>
				</annotation>
			</element>
			<element name="userDefinedDescriptionField" type="fews:ModifierUserDefinedDescriptionFieldComplexType" minOccurs="0" maxOccurs="5">
				<annotation>
					<documentation>Since 2015.01. FEWS-12001 Each added field will show up in the modifier properties panel. The "descriptionField" attribute is the text used for the GUI and the "id"
						attribute for the database. Because of limited space, the "id" attribute should be as short as possible.
					</documentation>
				</annotation>
			</element>
			<element name="whatIfModifierType" type="fews:WhatIfModifierType" minOccurs="0">
				<annotation>
					<documentation>Since 2021.01 Define how this modifier type should behave in workflows with a what-if applied</documentation>
				</annotation>
			</element>
			<element name="createPermission" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>Since 2024.02. Add permissions to create, update or delete a modifier of this type.</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="name" type="fews:idStringType" use="required"/>
	</complexType>
	<simpleType name="WhatIfModifierType">
		<restriction base="string">
			<enumeration value="always apply in workflow"/>
			<enumeration value="never apply in what-if workflows"/>
			<enumeration value="apply if referenced in what-if workflow"/>
			<enumeration value="apply according to creation method"/>
		</restriction>
	</simpleType>
	<complexType name="ModifierUserDefinedDescriptionFieldComplexType">
		<attribute name="id" type="fews:idStringType" use="required"/>
		<attribute name="descriptionField" type="string" use="required"/>
	</complexType>
	<complexType name="HardLimitsComplexType">
		<sequence>
			<element name="maximumValue" type="fews:floatStringAttributeAndPropertyType" minOccurs="0"/>
			<element name="minimumValue" type="fews:floatStringAttributeAndPropertyType" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="SoftLimitsComplexType">
		<sequence>
			<element name="maximumValue" type="fews:floatStringType"/>
			<element name="minimumValue" type="fews:floatStringType"/>
		</sequence>
	</complexType>
	<complexType name="PredefinedModuleParameterComplexType">
		<choice>
			<annotation>
				<documentation>Predefined parameter value that is filled in when a new parameter modifier is created</documentation>
			</annotation>
			<element name="dblValue" type="double"/>
			<element name="intValue" type="integer"/>
			<element name="boolValue" type="boolean"/>
			<element name="stringValue" type="string"/>
		</choice>
		<attribute name="id" type="fews:idStringType" use="required">
			<annotation>
				<documentation>module parameter id</documentation>
			</annotation>
		</attribute>
	</complexType>
	<group name="PredefinedModuleParameterGroup">
		<sequence>
			<element name="moduleParameter" type="fews:PredefinedModuleParameterComplexType" maxOccurs="unbounded">
				<annotation>
					<documentation>ID of this moduleParameter refers to parameter defined in pi_modelparameters.xml. Use this element to specify the predefined parameter value that is different from
						the value configured in pi_modelparameters.xml.
					</documentation>
				</annotation>
			</element>
		</sequence>
	</group>
</schema>
