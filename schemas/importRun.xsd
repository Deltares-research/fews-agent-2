<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.wldelft.nl/fews" xmlns:fews="http://www.wldelft.nl/fews" xmlns="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<include schemaLocation="unitConversions.xsd"/>
	<include schemaLocation="sharedTypes.xsd"/>
	<element name="importRun">
		<annotation>
			<documentation>Configuration settings for the import module</documentation>
		</annotation>
		<complexType>
			<sequence>
				<element name="import" type="fews:ImportRunComplexType" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="ImportRunComplexType">
		<annotation>
			<documentation>Configuration settings for an import type</documentation>
		</annotation>
		<sequence>
			<element name="folder" type="fews:directoryStringType" nillable="false">
				<annotation>
					<documentation>Folder in which import files are located</documentation>
				</annotation>
			</element>
			<element name="failedFolder" type="fews:directoryStringType" nillable="false" minOccurs="0">
				<annotation>
					<documentation>Files that could not be imported due to an error are copied to this folder.</documentation>
				</annotation>
			</element>
			<element name="backupFolder" type="fews:directoryStringType" nillable="false" minOccurs="0">
				<annotation>
					<documentation>Successfully imported files are moved to this folder.</documentation>
				</annotation>
			</element>
			<element name="validate" type="boolean" nillable="false" minOccurs="0">
				<annotation>
					<documentation>Option to allow validation of the import files against the EA Time series data exchange format schema.</documentation>
				</annotation>
			</element>
			<element name="idMapId" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>Id of IdMap to be used for locationId- and parameterId mapping</documentation>
				</annotation>
			</element>
			<element name="unitConversionsId" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>Id of UnitConversions to be used for unit mapping</documentation>
				</annotation>
			</element>
			<element name="flagConversionsId" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>Id of FlagConversions to be used for flag mapping</documentation>
				</annotation>
			</element>
			<element name="tolerance" type="fews:TimeStampToleranceComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Tolerance values for time stamp mapping</documentation>
				</annotation>
			</element>
			<element name="startTimeShift" type="fews:StartTimeShiftComplexType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Define the shift of the ExternalForecastStartTime according to the time of the first value in the import array.</documentation>
				</annotation>
			</element>
			<element name="timeSeriesSet" type="fews:TimeSeriesSetComplexType" nillable="false" maxOccurs="unbounded"/>
			<element name="importType" minOccurs="0">
				<annotation>
					<documentation>Type of data being imported</documentation>
				</annotation>
				<simpleType>
					<restriction base="string">
						<enumeration value="telemetry"/>
						<enumeration value="dds"/>
						<enumeration value="harp"/>
						<enumeration value="hyrad-k"/>
					</restriction>
				</simpleType>
			</element>
			<element name="importTimeZone" type="fews:TimeZoneComplexType" minOccurs="0">
				<annotation>
					<documentation>Time zone of the import data.</documentation>
				</annotation>
			</element>
			<element name="dataFeedId" type="fews:idStringType" minOccurs="0">
				<annotation>
					<documentation>Optional id for data feed. If not provided then the folder name will be used.</documentation>
				</annotation>
			</element>
			<element name="missingValue" type="float" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Missing value definition for this time series. Defaults to NaN if not defined.</documentation>
				</annotation>
			</element>
            <element name="traceValue" type="double" minOccurs="0" maxOccurs="unbounded">
                <annotation>
                    <documentation>Trace value definition for this time series. Defaults to NaN if not defined.</documentation>
                </annotation>
            </element>
		</sequence>
	</complexType>
	<complexType name="StartTimeShiftComplexType">
		<annotation>
			<documentation>Allows the external forecast start time to begin prior to the begin time of the imported time series.</documentation>
		</annotation>
		<sequence>
			<element name="locationId" type="fews:idStringType"/>
			<element name="parameterId" type="fews:idStringType"/>
			<element name="relativePeriod" type="fews:RelativePeriodComplexType"/>
		</sequence>
	</complexType>
</schema>
