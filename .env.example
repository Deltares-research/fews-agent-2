# FEWS configurator agent — environment template.
#
# Copy to `.env` (gitignored) and adjust. The web app loads this file
# at startup via python-dotenv, so you don't need to `export` anything.
#
# ---------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------
#
# FEWS_AGENT_PROVIDER picks the LLM backend used by the chat agent and
# the filter drafter. Recognised values (case-insensitive):
#
#   ollama     local Ollama daemon — default; needs `ollama serve` and
#              a model like `qwen2.5:7b-instruct` pulled locally
#   azure      Azure OpenAI — used for the cloud deployment; needs the
#              AZURE_OPENAI_* variables below
#   anthropic  Anthropic Claude (requires ANTHROPIC_API_KEY)
#
FEWS_AGENT_PROVIDER=ollama

# Optional: override the per-provider default model. For Azure this is
# treated as the deployment name (and is itself overridden by
# AZURE_OPENAI_DEPLOYMENT below if both are set).
# FEWS_AGENT_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------
# Ollama (default backend)
# ---------------------------------------------------------------------
# Inside Docker on Mac/Windows, the host's Ollama is reachable via
# host.docker.internal — already baked into the image. Override here if
# you run Ollama on a different host or port.
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------
# Azure OpenAI (cloud deployment)
# ---------------------------------------------------------------------
# Uncomment + fill these in to switch the agent to Azure OpenAI.
# In the Azure-deployed container these come from App Settings, not
# from a committed file — never commit a real key.
#
# FEWS_AGENT_PROVIDER=AZURE
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<resource-key>
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# ---------------------------------------------------------------------
# Anthropic (optional)
# ---------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
